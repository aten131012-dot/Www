function NX.addToggle(scroll, nameKey, descKey, callback, opts)
	local state = false
	local row = NX.makeRow(scroll, 46, true)
	NX.rowTexts(row, nameKey, descKey, 50)
	local box = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(22, 22), BackgroundColor3 = THEME.Off, BorderSizePixel = 0,
	}, row)
	corner(box, 4)
	local mark = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0, Visible = false,
	}, box)
	corner(mark, 2)
	local function set(v, silent)
		state = v and true or false
		mark.Visible = state
		local ok, err = pcall(callback, state)
		if not ok then warn("[NEXORA] " .. nameKey .. ": " .. tostring(err)) end
		if not silent then
			NX.notify(NX.L(nameKey) .. ": " .. (state and NX.L("on") or NX.L("off")))
		end
	end
	row.MouseButton1Click:Connect(function() set(not state) end)
	row.MouseEnter:Connect(function() row.BackgroundColor3 = THEME.RowHover end)
	row.MouseLeave:Connect(function() row.BackgroundColor3 = THEME.Row end)
	if not (opts and opts.noReset) then
		NX.Registry[#NX.Registry + 1] = {
			set = set, get = function() return state end, owner = scroll:GetAttribute("owner"),
		}
	end
	return set
end

function NX.addSlider(scroll, nameKey, min, max, default, step, onChange, suffix)
	suffix = suffix or ""
	local value = default
	local row = NX.makeRow(scroll, 54, false)
	local n = label(row, {
		Position = UDim2.fromOffset(10, 5), Size = UDim2.new(1, -90, 0, 20), Font = FONT_B, TextSize = 16,
	})
	NX.bindText(n, nameKey)
	local valueLabel = label(row, {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 5), Size = UDim2.fromOffset(70, 20),
		TextColor3 = THEME.Accent, TextXAlignment = Enum.TextXAlignment.Right, Font = FONT_B,
	})
	local trk = create("Frame", {
		Position = UDim2.new(0, 10, 0, 36), Size = UDim2.new(1, -20, 0, 4),
		BackgroundColor3 = THEME.Off, BorderSizePixel = 0,
	}, row)
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0 }, trk)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(8, 16), BackgroundColor3 = THEME.Text, BorderSizePixel = 0, ZIndex = 2,
	}, trk)
	corner(knob, 2)
	local hit = create("TextButton", {
		BackgroundTransparency = 1, Text = "", Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 30),
	}, row)
	local function render(v)
		local rel = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(rel, 1)
		knob.Position = UDim2.fromScale(rel, 0.5)
		valueLabel.Text = tostring(v) .. suffix
	end
	local function setFromX(x)
		local rel = math.clamp((x - trk.AbsolutePosition.X) / math.max(trk.AbsoluteSize.X, 1), 0, 1)
		local v = math.floor((min + (max - min) * rel) / step + 0.5) * step
		v = tonumber(string.format("%.2f", math.clamp(v, min, max)))
		if v ~= value then
			value = v
			render(v)
			local ok, err = pcall(onChange, v)
			if not ok then warn("[NEXORA] slider " .. nameKey .. ": " .. tostring(err)) end
		end
	end
	local dragging = false
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			scroll.ScrollingEnabled = false
			setFromX(input.Position.X)
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					scroll.ScrollingEnabled = true
					c:Disconnect()
				end
			end)
		end
	end)
	NX.track(UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end))
	render(default)
end

