function NX.makeDraggable(handle, target, getScale, onClick)
	local dragging, moved, dragStart, startPos = false, false, nil, nil
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved = true, false
			dragStart, startPos = input.Position, target.Position
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					c:Disconnect()
					dragging = false
					if not moved and onClick then onClick() end
				end
			end)
		end
	end)
	NX.track(UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			if d.Magnitude > 8 then moved = true end
			if moved then
				local s = math.max(getScale(), 0.1)
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X / s,
					startPos.Y.Scale, startPos.Y.Offset + d.Y / s)
			end
		end
	end))
end

