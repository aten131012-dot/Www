local Pages, TabButtons, CurrentPage = {}, {}, nil

function NX.switchPage(key)
	if CurrentPage == key or not Pages[key] then return end
	CurrentPage = key
	for k, b in pairs(TabButtons) do b.setActive(k == key) end
	for k, p in pairs(Pages) do p.Group.Visible = (k == key) end
end

function NX.removePage(key)
	local p = Pages[key]
	if not p then return end
	for i = #NX.Registry, 1, -1 do
		local e = NX.Registry[i]
		if e.owner == key then
			if e.get() then pcall(e.set, false, true) end
			table.remove(NX.Registry, i)
		end
	end
	p.Group:Destroy()
	TabButtons[key].btn:Destroy()
	Pages[key], TabButtons[key] = nil, nil
	if CurrentPage == key then CurrentPage = nil NX.switchPage("tab_home") end
end

function NX.addPage(key, order)
	NX.removePage(key)
