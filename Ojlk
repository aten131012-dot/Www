local Afk = {}
local function afk(on)
	if on then
		local root = getRoot()
		if not root then NX.notify(NX.L("fm_no_root")) return end
		Afk.Return = root.CFrame
		local pos = root.Position + Vector3.new(0, State.AfkHeight, 0)
		Afk.Part = create("Part", {
			Name = "NX_Platform", Anchored = true, Size = Vector3.new(30, 2, 30), Position = pos,
			Transparency = 0.6, Color = THEME.Accent, Material = Enum.Material.SmoothPlastic,
		}, Workspace)
		root.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
		bind("FM_AFK", RunService.Heartbeat, function()
			local r = getRoot()
			if r and Afk.Part and (r.Position - Afk.Part.Position).Magnitude > 60 then
				r.CFrame = CFrame.new(Afk.Part.Position + Vector3.new(0, 4, 0))
			end
		end)
	else
		unbind("FM_AFK")
		if Afk.Part then Afk.Part:Destroy() Afk.Part = nil end
		local r = getRoot()
		if r and Afk.Return then r.CFrame = Afk.Return end
		Afk.Return = nil
	end
end

local Bots = {}
local function scanBot(inst)
	if inst:IsA("Humanoid") then
		local m = inst.Parent
		if m and m:IsA("Model") and m ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(m) then
			Bots[m] = true
		end
	end
end
local avoidT = 0
local function avoid(on)
	if on then
		for _, d in ipairs(Workspace:GetDescendants()) do scanBot(d) end
		bind("FM_BOT_ADD", Workspace.DescendantAdded, scanBot)
		bind("FM_AVOID", RunService.Heartbeat, function(dt)
			avoidT += dt
			if avoidT < 0.1 then return end
			avoidT = 0
			local root = getRoot()
			if not root then return end
			for m in pairs(Bots) do
				if not m.Parent then
					Bots[m] = nil
				else
					local part = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
					if part then
						local off = root.Position - part.Position
						if off.Magnitude < State.AvoidDist then
							local flat = Vector3.new(off.X, 0, off.Z)
							local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(1, 0, 0)
							root.CFrame = root.CFrame + dir * (State.AvoidDist + 25) + Vector3.new(0, 3, 0)
							break
						end
					end
				end
			end
		end)
	else
		unbind("FM_AVOID")
		unbind("FM_BOT_ADD")
		table.clear(Bots)
	end
end

local Items, Visited = {}, {}
local function nameMatches(name)
	name = name:lower()
	for _, p in ipairs(COLLECT_PATTERNS) do
		if name:find(p, 1, true) then return true end
	end
	return false
end
local function scanItem(inst)
	if inst:IsA("BasePart") and nameMatches(inst.Name) then
		local ch = LocalPlayer.Character
		if ch and inst:IsDescendantOf(ch) then return end
		local m = inst:FindFirstAncestorOfClass("Model")
		if not m or not m:FindFirstChildOfClass("Humanoid") then Items[inst] = true end
	end
end
local collectT = 0
local function collect(on)
	if on then
		table.clear(Visited)
		for _, d in ipairs(Workspace:GetDescendants()) do scanItem(d) end
		bind("FM_ITEM_ADD", Workspace.DescendantAdded, scanItem)
		collectT = 0
		bind("FM_COLLECT", RunService.Heartbeat, function(dt)
			collectT += dt
			if collectT < State.CollectInterval then return end
			collectT = 0
			local root = getRoot()
			if not root then return end
			local best, bestD
			local now = os.clock()
			for part in pairs(Items) do
				if not part.Parent then
					Items[part] = nil
				elseif not Visited[part] or now - Visited[part] > 5 then
					local d = (part.Position - root.Position).Magnitude
					if d <= State.CollectRange and (not bestD or d < bestD) then best, bestD = part, d end
				end
			end
			if best then
				Visited[best] = now
				root.CFrame = best.CFrame + Vector3.new(0, 2, 0)
				pcall(function()
					if firetouchinterest then
						firetouchinterest(root, best, 0)
						firetouchinterest(root, best, 1)
					end
				end)
				pcall(function()
					local prompt = best:FindFirstChildWhichIsA("ProximityPrompt", true)
					if prompt and fireproximityprompt then fireproximityprompt(prompt) end
				end)
			end
		end)
	else
		unbind("FM_COLLECT")
		unbind("FM_ITEM_ADD")
		table.clear(Items)
	end
end

local function isDowned(plr)
	local ch = plr.Character
	if not ch then return false end
	for _, a in ipairs(DOWNED_ATTRS) do
		if ch:GetAttribute(a) then return true end
	end
	return false
end
local reviveT = 0
local function revive(on)
	if on then
		reviveT = 0
		bind("FM_REVIVE", RunService.Heartbeat, function(dt)
			reviveT += dt
			if reviveT < 0.5 then return end
			reviveT = 0
			local root = getRoot()
			if not root then return end
			local best, bestD
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer and isDowned(plr) then
					local r = plr.Character:FindFirstChild("HumanoidRootPart")
					if r then
						local d = (r.Position - root.Position).Magnitude
						if not bestD or d < bestD then best, bestD = plr, d end
					end
				end
			end
			if best then
				root.CFrame = best.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
				pcall(function()
					if not fireproximityprompt then return end
					for _, d in ipairs(best.Character:GetDescendants()) do
						if d:IsA("ProximityPrompt") then fireproximityprompt(d) end
					end
				end)
			end
		end)
	else
		unbind("FM_REVIVE")
	end
end

