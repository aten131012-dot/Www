	if on then
		local h = getHum()
		if h and Orig.Speed == nil then Orig.Speed = h.WalkSpeed end
		bind("PL_SPEED", RunService.Heartbeat, function()
			local hum = getHum()
			if hum then hum.WalkSpeed = State.Speed end
		end)
	else
		unbind("PL_SPEED")
		local h = getHum()
		if h and Orig.Speed then h.WalkSpeed = Orig.Speed end
		Orig.Speed = nil
	end
end

local function jumpPower(on)
	if on then
		local h = getHum()
		if h and Orig.Jump == nil then Orig.Jump, Orig.UseJP = h.JumpPower, h.UseJumpPower end
		bind("PL_JUMP", RunService.Heartbeat, function()
			local hum = getHum()
			if hum then hum.UseJumpPower = true hum.JumpPower = State.Jump end
		end)
	else
		unbind("PL_JUMP")
		local h = getHum()
		if h and Orig.Jump ~= nil then h.UseJumpPower, h.JumpPower = Orig.UseJP, Orig.Jump end
		Orig.Jump, Orig.UseJP = nil, nil
	end
end

local function infJump(on)
	if on then
		bind("PL_INF", UIS.JumpRequest, function()
			local h = getHum()
			if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
		end)
	else
		unbind("PL_INF")
	end
end

local function noclip(on)
	if on then
		bind("PL_NOCLIP", RunService.Stepped, function()
			local c = LocalPlayer.Character
			if not c then return end
			for _, p in ipairs(c:GetDescendants()) do
				if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
			end
		end)
	else
		unbind("PL_NOCLIP")
	end
end

local Fly = {}
local function clearFly()
	if Fly.BV then Fly.BV:Destroy() Fly.BV = nil end
	if Fly.BG then Fly.BG:Destroy() Fly.BG = nil end
end
local function fly(on)
	if on then
		bind("PL_FLY", RunService.Heartbeat, function()
			local hum, root, cam = getHum(), getRoot(), Workspace.CurrentCamera
			if not hum or not root or not cam then return end
			if not Fly.BV or Fly.BV.Parent ~= root then
				clearFly()
				Fly.BV = create("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero }, root)
				Fly.BG = create("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 9e4, CFrame = root.CFrame }, root)
			end
			hum.PlatformStand = true
			local vel, move = Vector3.zero, hum.MoveDirection
			if move.Magnitude > 0 then
				local cf = cam.CFrame
				local rel = cf:VectorToObjectSpace(move)
				local dir = cf.RightVector * rel.X - cf.LookVector * rel.Z
				if dir.Magnitude > 0 then vel = dir.Unit * State.FlySpeed end
			end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then vel += Vector3.new(0, State.FlySpeed, 0) end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then vel -= Vector3.new(0, State.FlySpeed, 0) end
			Fly.BV.Velocity = vel
			local look = cam.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 0.01 then
				Fly.BG.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
			end
		end)
	else
		unbind("PL_FLY")
		clearFly()
		local h = getHum()
		if h then h.PlatformStand = false end
	end
end

local function gravity(on)
	if on then
		if not Orig.Grav then Orig.Grav = Workspace.Gravity end
		bind("PL_GRAV", RunService.Heartbeat, function() Workspace.Gravity = State.Gravity end)
	else
		unbind("PL_GRAV")
		if Orig.Grav then Workspace.Gravity = Orig.Grav end
		Orig.Grav = nil
	end
end

local function tpTo(plr)
	local mine = getRoot()
	local theirs = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if mine and theirs then
		mine.CFrame = theirs.CFrame * CFrame.new(0, 0, 3)
		NX.notify(NX.L("pl_tped") .. " " .. plr.DisplayName)
	end
end
local function spectate(plr)
	local cam = Workspace.CurrentCamera
	local h = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if cam and h then
		cam.CameraSubject = h
		NX.notify(NX.L("pl_viewing") .. " " .. plr.DisplayName)
	end
end
local function stopSpectate()
	local cam, h = Workspace.CurrentCamera, getHum()
	if cam and h then cam.CameraSubject = h end
end
