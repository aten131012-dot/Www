function NX.notify(msg)
	if not NX.Settings.Notify then return end
	toastId += 1
	local id = toastId
	ToastText.Text = msg
	Toast.Visible = true
	tween(Toast, 0.15, { BackgroundTransparency = 0 })
	tween(ToastStroke, 0.15, { Transparency = 0 })
	tween(ToastText, 0.15, { TextTransparency = 0 })
	task.delay(1.6, function()
		if id ~= toastId then return end
		tween(Toast, 0.2, { BackgroundTransparency = 1 })
		tween(ToastStroke, 0.2, { Transparency = 1 })
		tween(ToastText, 0.2, { TextTransparency = 1 })
		task.delay(0.22, function() if id == toastId then Toast.Visible = false end end)
	end)
