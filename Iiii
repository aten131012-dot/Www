local function slashAng(k)
	if k<0.3 then return -2.3*(k/0.3)
	elseif k<0.5 then return -2.3+4.0*((k-0.3)/0.2)
	else return 1.7*(1-(k-0.5)/0.5) end
end

local ph,sgn,lastG=0,1,os.clock()
local function animate(root,hum)
	if S.conn then S.conn:Disconnect() end
	S.conn=RunService.RenderStepped:Connect(function(dt)
		if not R.model or not R.model.Parent then return end
		local J,P=R.joints,R.parts
		local t=os.clock()
		local v=root.AssemblyLinearVelocity
		local sp=Vector3.new(v.X,0,v.Z).Magnitude
		local a=math.clamp(sp/22,0,1)
		ph=ph+dt*(1.5+sp*0.2)
		local s,c=math.sin(ph),math.cos(ph)
		-- ขา
		J.ULegL.C0=CFrame.new(-2.3,12,0)*CFrame.Angles(s*0.6*a,0,0)
		J.ULegR.C0=CFrame.new(2.3,12,0)*CFrame.Angles(-s*0.6*a,0,0)
		J.LLegL.C0=CFrame.new(0,-3,0)*CFrame.Angles(-math.max(0,c)*0.9*a,0,0)
		J.LLegR.C0=CFrame.new(0,-3,0)*CFrame.Angles(-math.max(0,-c)*0.9*a,0,0)
		J.Pelvis.C0=CFrame.new(0,12.2+math.abs(s)*0.35*a+math.sin(t*1.5)*0.05,0)
		-- แขน (ค่าปกติ)
		local aL,aR=-s*0.5*a,s*0.5*a
		local zL,zR=-0.1+math.sin(t*1.5)*0.02,0.1-math.sin(t*1.5)*0.02
		local eL,eR=0.25+0.25*a,0.25+0.25*a
		local ht,tt,ty=0,0,0
		if act.name then
			act.t=act.t+dt
			local k=act.t/act.dur
			if k>=1 then
				act.name=nil
			elseif act.name=="slash" then
				aR=slashAng(k)
				aL=slashAng(math.clamp((k-0.2)/0.8,0,1))
				eL,eR=0.1,0.1
				ty=-math.sin(k*math.pi)*0.5
			else
				local b=math.sin(k*math.pi)
				aL,aR=-0.3*b,-0.3*b
				zL,zR=-1.1*b,1.1*b
				eL,eR=0.4*b,0.4*b
				ht,tt=0.55*b,0.2*b
			end
		end
		J.ArmL.C0=CFrame.new(-5.9,3.6,0)*CFrame.Angles(aL,0,zL)
		J.ArmR.C0=CFrame.new(5.9,3.6,0)*CFrame.Angles(aR,0,zR)
		J.ForeL.C0=CFrame.new(0,-2.7,0)*CFrame.Angles(eL,0,0)
		J.ForeR.C0=CFrame.new(0,-2.7,0)*CFrame.Angles(eR,0,0)
		J.Torso.C0=CFrame.new(0,1.2+math.sin(t*1.5)*0.08,0)*CFrame.Angles(-0.07*a+tt,s*0.1*a+ty,0)
		J.Head.C0=CFrame.new(0,4.4,0)*CFrame.Angles(ht+math.sin(t*0.7)*0.03,math.sin(t*0.5)*0.07,0)
		-- โค้ทพลิ้ว
		local sw=math.sin(t*2)*0.03
		J.CoatFL.C0=CFrame.new(-2.3,13.4,-2.6)*CFrame.Angles(math.max(0,s)*0.55*a+sw,0,0)
		J.CoatFR.C0=CFrame.new(2.3,13.4,-2.6)*CFrame.Angles(math.max(0,-s)*0.55*a+sw,0,0)
		J.CoatB.C0=CFrame.new(0,13.4,2.6)*CFrame.Angles(-0.1-a*0.4-sw,0,0)
		J.CoatSL.C0=CFrame.new(-4.8,13.4,0)*CFrame.Angles(0,0,-0.06-a*0.15-sw)
		J.CoatSR.C0=CFrame.new(4.8,13.4,0)*CFrame.Angles(0,0,0.06+a*0.15+sw)
		-- แกนพลังงานเต้น เฟืองหมุน ดาบเรืองแสง
		local cs=1.6+0.2*math.sin(t*4)
		P.Core.Size=Vector3.new(cs,cs,cs)
		R.coreLight.Range=22+math.sin(t*4)*4
		J.Gear.C0=R.gear0*CFrame.Angles(t*1.2,0,0)
		P.BladeGlowL.Transparency=0.15+0.15*math.sin(t*5)
		P.BladeGlowR.Transparency=0.15+0.15*math.sin(t*5+1)
		-- จอกระตุกสุ่ม
		if t-lastG>3+math.random()*3 then
			lastG=t
			task.spawn(glitch)
		end
		-- เสียงฝีเท้า + กล้องสั่น
		local sg=s>=0 and 1 or -1
		if sg~=sgn then
			sgn=sg
			if a>0.35 then
				sfx(SND.step,0.7,0.5)
				hum.CameraOffset=Vector3.new(0,CAMY-0.35,0)
				tw(hum,0.2,{CameraOffset=Vector3.new(0,CAMY,0)})
			end
		end
	end)
end-- (7/8)
local function playAction(name,force)
	if act.name or (not force and not S.active) then return end
	act.name=name
	act.t=0
	if name=="slash" then
		act.dur=1.1
		task.delay(0.33,function() sfx(SND.slash,1,0.8) end)
		task.delay(0.55,function() sfx(SND.slash,1,0.7) end)
	else
		act.dur=2.6
		sfx(SND.roar,2,0.55)
		sfx(SND.boom,1,0.8)
		for i=0,3 do
			task.delay(i*0.6,function() task.spawn(glitch) end)
		end
		if R.coreLight then
			tw(R.coreLight,0.6,{Brightness=8})
			task.delay(1.8,function()
				if R.coreLight then tw(R.coreLight,0.8,{Brightness=2}) end
			end)
		end
		if not force then
			task.spawn(function()
				local ch=player.Character
				local hum=ch and ch:FindFirstChildOfClass("Humanoid")
				local t0=os.clock()
				while hum and os.clock()-t0<2 do
					hum.CameraOffset=Vector3.new(math.random(-8,8)/30,CAMY+math.random(-8,8)/30,0)
					task.wait()
				end
				if hum then hum.CameraOffset=Vector3.new(0,CAMY,0) end
			end)
		end
	end
end-- (8a)
local function hideChar(char,hide)
	for _,d in ipairs(char:GetDescendants()) do
		if (d:IsA("BasePart") or d:IsA("Decal")) and d.Name~="HumanoidRootPart" then
			if hide then
				S.saved[d]=d.Transparency
				d.Transparency=1
			elseif S.saved[d] then
				d.Transparency=S.saved[d]
			end
		end
	end
end

local function ring(pos,delay,big)
	task.delay(delay,function()
		local r=Instance.new("Part")
		r.Shape=Enum.PartType.Cylinder
		r.Anchored=true
		r.CanCollide=false
		r.CanQuery=false
		r.Material=Enum.Material.Neon
		r.Color=PURPLE
		r.Size=Vector3.new(0.4,2,2)
		r.CFrame=CFrame.new(pos+Vector3.new(0,0.5,0))*CFrame.Angles(0,0,rad(90))
		r.Parent=workspace
		tw(r,1.4,{Size=Vector3.new(0.4,big,big),Transparency=1})
		Debris:AddItem(r,1.6)
	end)
end

local function emitter(parent,tex,color,size,rate,life,speed,light)
	local e=Instance.new("ParticleEmitter")
	e.Texture=tex
	e.Color=ColorSequence.new(color)
	e.Size=NumberSequence.new(size[1],size[2])
	e.Transparency=NumberSequence.new({
		NumberSequenceKeypoint.new(0,1),
		NumberSequenceKeypoint.new(0.2,light and 0 or 0.25),
		NumberSequenceKeypoint.new(1,1)})
	e.Rate=rate
	e.Lifetime=NumberRange.new(life,life+1)
	e.Speed=NumberRange.new(speed,speed*2)
	e.SpreadAngle=Vector2.new(180,180)
	e.Acceleration=Vector3.new(0,6,0)
	e.RotSpeed=NumberRange.new(-40,40)
	e.LightEmission=light and 1 or 0
	e.Parent=parent
	return e
end-- (8a ต่อ) คัทซีน
local function transform()
	local char=player.Character
	local hum=char and char:FindFirstChildOfClass("Humanoid")
	local root=char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or S.busy then return end
	S.busy=true
	local o=S.old
	o.hip,o.speed=hum.HipHeight,hum.WalkSpeed
	o.zmax,o.zmin,o.coff=player.CameraMaxZoomDistance,player.CameraMinZoomDistance,hum.CameraOffset
	o.nd=hum.DisplayDistanceType
	local fog={Lighting.FogColor,Lighting.FogStart,Lighting.FogEnd,Lighting.Ambient,Lighting.OutdoorAmbient,Lighting.Brightness}
	local f=root.CFrame.LookVector*Vector3.new(1,0,1)
	f=f.Magnitude>0 and f.Unit or Vector3.new(0,0,-1)
	local ground=root.Position-Vector3.new(0,o.hip+root.Size.Y/2,0)
	root.Anchored=true

	-- 1) หมอกดำ
	sfx(SND.fog,1.2,0.6)
	local cc=Instance.new("ColorCorrectionEffect")
	cc.Parent=Lighting
	tw(Lighting,2,{FogColor=C(0,0,0),FogStart=0,FogEnd=90,Ambient=C(10,10,14),OutdoorAmbient=C(10,10,14),Brightness=0.4})
	tw(cc,2,{Brightness=-0.15,Contrast=0.25,Saturation=-0.4})
	cam.CameraType=Enum.CameraType.Scriptable
	cam.CFrame=CFrame.lookAt(ground+f*34+Vector3.new(8,3,0),ground+Vector3.new(0,6,0))
	local sp=Instance.new("Part")
	sp.Anchored=true
	sp.CanCollide=false
	sp.CanQuery=false
	sp.Transparency=1
	sp.Size=Vector3.new(26,1,26)
	sp.Position=ground
	sp.Parent=workspace
	local smoke=emitter(sp,"rbxasset://textures/particles/smoke_main.dds",C(0,0,0),{12,26},70,3,5,false)
	local sparks=emitter(sp,"rbxasset://textures/particles/sparkles_main.dds",PURPLE,{0.8,0},45,1.2,12,true)
	task.wait(2)

	-- 2) ร่างปรากฏจากเท้าขึ้นหัว + เสียงพูดแรก
	root.CFrame=root.CFrame+Vector3.new(0,HIP-o.hip,0)
	hum.HipHeight=HIP
	local model=buildTitan(root)
	hideChar(char,true)
	hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
	animate(root,hum)
	task.wait(0.2)
	sfx(SND.boom,1.5,0.5)
	ring(ground,0,70)
	ring(ground,0.4,110)
	for _,p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") and p.Name~="Base" then
			local h=math.clamp((p.Position.Y-ground.Y)/30,0,1)
			task.delay(h*2.2,function()
				if p.Parent then tw(p,0.5,{Transparency=0}) end
			end)
		end
	end
	for _,d in ipairs(model:GetDescendants()) do
		if d:IsA("Light") then d.Enabled=true end
	end
	task.delay(2.2,function()
		if R.faceGui then R.faceGui.Enabled=true end
	end)
	tw(cam,3.2,{CFrame=CFrame.lookAt(ground+f*40+Vector3.new(0,14,0),ground+Vector3.new(0,17,0))},Enum.EasingStyle.Quad)
	task.delay(1.5,function() speak(V_ARRIVE) end)
	task.wait(3.2)

	-- 3) ซูมหน้าจอ ยิ้มกวน แล้วคำราม
	R.setFace("smirk")
	sfx(SND.glitch,1,0.5)
	tw(cam,1.2,{CFrame=CFrame.lookAt(ground+f*17+Vector3.new(0,25,0),ground+Vector3.new(0,25.5,0))},Enum.EasingStyle.Quint)
	task.wait(1.5)
	R.setFace("mad")
	playAction("roar",true)
	speak(V_ROAR)
	local base=cam.CFrame
	local t0=os.clock()
	while os.clock()-t0<2.4 do
		cam.CFrame=base*CFrame.new(math.random(-8,8)/25,math.random(-8,8)/25,0)
		task.wait()
	end
	R.setFace("smirk")
	tw(cam,1.5,{CFrame=CFrame.lookAt(ground+f*38+Vector3.new(0,12,0),ground+Vector3.new(0,16,0))})
	speak(V_END)
	task.wait(2.2)

	-- 4) จบคัทซีน
	R.setFace("calm")
	tw(Lighting,2.5,{FogColor=fog[1],FogStart=fog[2],FogEnd=fog[3],Ambient=fog[4],OutdoorAmbient=fog[5],Brightness=fog[6]})
	tw(cc,2.5,{Brightness=0,Contrast=0,Saturation=0})
	smoke.Enabled=false
	sparks.Enabled=false
	cam.CameraType=Enum.CameraType.Custom
	cam.CameraSubject=hum
	root.Anchored=false
	hum.WalkSpeed=26
	hum.CameraOffset=Vector3.new(0,CAMY,0)
	player.CameraMinZoomDistance=30
	player.CameraMaxZoomDistance=120
	emitter(R.parts.Base,"rbxasset://textures/particles/smoke_main.dds",C(0,0,0),{8,14},8,2.5,3,false)
	Debris:AddItem(sp,5)
	Debris:AddItem(cc,3)
	S.active=true
	S.busy=false
end-- (8b)
