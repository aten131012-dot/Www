local function buildTitan(root)
	R.joints,R.parts={},{}
	R.model=Instance.new("Model")
	R.model.Name="TitanTVMan"
	local gy=-(HIP+root.Size.Y/2)
	local base=limb("Base",Vector3.new(1,1,1),BLACK,nil,root,CFrame.new(0,gy,0))
	buildLegs(base)
	buildTorso()
	buildHead()
	buildFace()
	buildArms()
	for _,d in ipairs(R.model:GetDescendants()) do
		if d:IsA("Light") then d.Enabled=false end
	end
