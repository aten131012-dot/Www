local function groundAhead()
	local P=R.parts
	if not P.Base or not P.Head then return nil end
	local f=P.Head.CFrame.LookVector*Vector3.new(1,0,1)
	if f.Magnitude<0.05 then f=Vector3.new(0,0,-1) end
	return P.Base.Position,f.Unit
end

