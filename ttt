local function slashAng(k)
	if k<0.3 then return -2.3*(k/0.3)
	elseif k<0.5 then return -2.3+4.0*((k-0.3)/0.2)
	else return 1.7*(1-(k-0.5)/0.5) end
end

local ph,sgn=0,1
local sm={aL=0.2,aR=0.3,zL=0,zR=0,eL=0.9,eR=1.05}

local function animate(root,hum)
	if S.conn then S.conn:Disconnect() end
	S.conn=RunService.RenderStepped:Connect(function(dt)
		if not R.model or not R.model.Parent then return end
		local P=R.parts
		local t=os.clock()
		local v=root.AssemblyLinearVelocity
		local sp=Vector3.new(v.X,0,v.Z).Magnitude
		S.fa=S.fa+((S.fly and 1 or 0)-S.fa)*math.clamp(dt*5,0,1)
		local fa=S.fa
		local a=math.clamp(sp/WALK,0,1)*(1-fa)
		ph=ph+dt*(1.1+sp*0.1)
		local s,c=math.sin(ph),math.cos(ph)
		local br=math.sin(t*1.5)
		-- ขา
		setJ("ULegL",CFrame.new(-2.3,12,0)*CFrame.Angles(s*0.6*a+0.15*fa,0,0))
		setJ("ULegR",CFrame.new(2.3,12,0)*CFrame.Angles(-s*0.6*a-0.05*fa,0,0))
		setJ("LLegL",CFrame.new(0,-3,0)*CFrame.Angles(-math.max(0,c)*0.9*a-0.6*fa,0,0))
		setJ("LLegR",CFrame.new(0,-3,0)*CFrame.Angles(-math.max(0,-c)*0.9*a-0.9*fa,0,0))
		setJ("Pelvis",CFrame.new(0,12.2+math.abs(s)*0.35*a+br*0.05,0))
		-- แขน (ท่าพร้อมสู้ + ท่าบิน)
		local aL,aR=0.2-s*0.4*a,0.3+s*0.3*a
		local zL,zR=-0.1+br*0.02,0.1-br*0.02
		local eL,eR=0.9,1.05
		aL=aL+(-0.5-aL)*fa
		aR=aR+(-0.2-aR)*fa
		eL=eL+(0.2-eL)*fa
		eR=eR+(0.3-eR)*fa
		zL=zL+(-0.35-zL)*fa
		zR=zR+(0.35-zR)*fa
		local ht,tt,ty=0,0,0
		if act.name then
			act.t=act.t+dt
			local k=act.t/act.dur
			local b=math.min(math.clamp(act.t/0.35,0,1),math.clamp((act.dur-act.t)/0.35,0,1))
			if k>=1 then
				act.name=nil
			elseif act.name=="slash" then
				aR=slashAng(k)
				aL=0.2+slashAng(math.clamp((k-0.2)/0.8,0,1))*0.4
				eL,eR=0.5,0.1
				ty=-math.sin(k*math.pi)*0.5
			elseif act.name=="shoot" then
				local rec=act.t>act.fire and math.max(0,1-(act.t-act.fire)/0.3) or 0
				aL=aL+((1.5+act.pitch)-aL)*b-0.3*rec
				eL=eL+(0.05-eL)*b
				zL=zL+(-0.1-zL)*b
				tt=0.18*rec
			elseif act.name=="red" then
				aL=aL+(-0.2-aL)*b
				aR=aR+(-0.2-aR)*b
				eL=eL+(0.3-eL)*b
				eR=eR+(0.3-eR)*b
				zL=zL+(-1.0-zL)*b
				zR=zR+(1.0-zR)*b
				tt=0.22*b
			elseif act.name=="blue" then
				aL=aL+(0-aL)*b
				aR=aR+(0-aR)*b
				eL=eL+(0.2-eL)*b
				eR=eR+(0.2-eR)*b
				zL=zL+(-1.7-zL)*b
				zR=zR+(1.7-zR)*b
				tt=0.12*b
				ht=0.15*b
			else
				local bb=math.sin(k*math.pi)
				aL=aL+(-0.3-aL)*bb
				aR=aR+(-0.3-aR)*bb
				zL=zL+(-1.1-zL)*bb
				zR=zR+(1.1-zR)*bb
				eL=eL+(0.4-eL)*bb
				eR=eR+(0.4-eR)*bb
				ht,tt=0.55*bb,0.2*bb
			end
		end
		local f=math.clamp(dt*20,0,1)
		sm.aL=sm.aL+(aL-sm.aL)*f
		sm.aR=sm.aR+(aR-sm.aR)*f
		sm.zL=sm.zL+(zL-sm.zL)*f
		sm.zR=sm.zR+(zR-sm.zR)*f
		sm.eL=sm.eL+(eL-sm.eL)*f
		sm.eR=sm.eR+(eR-sm.eR)*f
		setJ("ArmL",CFrame.new(-5.9,3.6,0)*CFrame.Angles(sm.aL,0,sm.zL))
		setJ("ArmR",CFrame.new(5.9,3.6,0)*CFrame.Angles(sm.aR,0,sm.zR))
		setJ("ForeL",CFrame.new(0,-2.7,0)*CFrame.Angles(sm.eL,0,0))
		setJ("ForeR",CFrame.new(0,-2.7,0)*CFrame.Angles(sm.eR,0,0))
		setJ("Torso",CFrame.new(0,1.2+br*0.08,0)*CFrame.Angles(-0.07*a+tt,s*0.1*a+ty,0))
		setJ("Head",CFrame.new(0,4.4,0)*CFrame.Angles(ht+S.tilt*0.8+math.sin(t*0.7)*0.03,math.sin(t*0.5)*0.07,0))
		-- โค้ทพลิ้ว
		local sw=math.sin(t*2)*0.03
		setJ("CoatFL",CFrame.new(-2.3,13.4,-2.6)*CFrame.Angles(math.max(0,s)*0.55*a+sw-0.4*fa,0,0))
		setJ("CoatFR",CFrame.new(2.3,13.4,-2.6)*CFrame.Angles(math.max(0,-s)*0.55*a+sw-0.4*fa,0,0))
		setJ("CoatB",CFrame.new(0,13.4,2.6)*CFrame.Angles(-0.1-a*0.4-sw-0.7*fa,0,0))
		setJ("CoatSL",CFrame.new(-4.8,13.4,0)*CFrame.Angles(0,0,-0.06-a*0.15-sw))
		setJ("CoatSR",CFrame.new(4.8,13.4,0)*CFrame.Angles(0,0,0.06+a*0.15+sw))
		-- แกนพลังงาน เฟือง ออร่าดาบ
		local cs=1.6+0.2*math.sin(t*4)
		P.Core.Size=Vector3.new(cs,cs,cs)*K
		R.coreLight.Range=math.min(60,22*K+math.sin(t*4)*4)
		setJ("Gear",R.gear0*CFrame.Angles(t*1.2,0,0))
		if R.shown then
			P.SwordAura.Transparency=0.62+0.12*math.sin(t*6)
		end
		-- ไฟแจ็คแพ็ค
		local th=S.thrust
		for _,x in ipairs(R.fl) do
			x.em.Rate=th>0.01 and (40+260*th) or 0
			x.lt.Brightness=th*4
		end
		-- เสียงฝีเท้า + กล้องสั่น
		local sg=s>=0 and 1 or -1
		if sg~=sgn then
			sgn=sg
			if a>0.35 then
				sfx(SND.step,0.8,0.4)
				hum.CameraOffset=Vector3.new(0,CAMY-0.5*K,0)
				tw(hum,0.2,{CameraOffset=Vector3.new(0,CAMY,0)})
			end
		end
	end)
end-- (10/13) เอฟเฟกต์ + สกิลจอแดง + สกิลแสงจอ
