	bg.Size=UDim2.fromScale(1,1)
	bg.BackgroundColor3=C(8,0,0)
	label(bg,"NEXORA",60,UDim2.fromScale(0.5,0.34),Enum.Font.GothamBlack,C(220,0,0))
	label(bg,T("load"),22,UDim2.fromScale(0.5,0.46))
	local st=label(bg,"",16,UDim2.fromScale(0.5,0.66),Enum.Font.Gotham,C(180,180,180))
	local bar=Instance.new("Frame",bg)
	bar.AnchorPoint=Vector2.new(0.5,0.5)
	bar.Position=UDim2.fromScale(0.5,0.58)
	bar.Size=UDim2.new(0.6,0,0,14)
	bar.BackgroundColor3=C(35,0,0)
	Instance.new("UICorner",bar).CornerRadius=UDim.new(1,0)
	local fill=Instance.new("Frame",bar)
	fill.Size=UDim2.fromScale(0,1)
	fill.BackgroundColor3=C(220,0,0)
	Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
	task.spawn(function()
		local list={}
		for _,id in pairs(SND) do
			local s=Instance.new("Sound")
			s.SoundId=id
			table.insert(list,s)
		end
		for i,k in ipairs({"l1","l2","l3","l4"}) do
			st.Text=T(k)
			tw(fill,0.9,{Size=UDim2.fromScale(i/4,1)})
			if i==2 then
				pcall(function() game:GetService("ContentProvider"):PreloadAsync(list) end)
			end
			task.wait(1)
		end
		task.wait(0.4)
		for _,s in ipairs(list) do s:Destroy() end
		g:Destroy()
		cb()
	end)
end

local function startMain()
	local gui=mkGui("NexoraTitanTV",10)
	gui.IgnoreGuiInset=false
	local holder=Instance.new("Frame")
	holder.AnchorPoint=Vector2.new(1,0.5)
	holder.Position=UDim2.new(1,-6,0.5,0)
	holder.Size=UDim2.new(0,112,0,0)
	holder.AutomaticSize=Enum.AutomaticSize.Y
	holder.BackgroundTransparency=1
	holder.Parent=gui
	local lay=Instance.new("UIListLayout")
	lay.Padding=UDim.new(0,4)
	lay.SortOrder=Enum.SortOrder.LayoutOrder
	lay.HorizontalAlignment=Enum.HorizontalAlignment.Right
	lay.Parent=holder
	local function mkBtn(text,order)
		local b=Instance.new("TextButton")
		b.LayoutOrder=order
		b.Size=UDim2.new(1,0,0,34)
		b.BackgroundColor3=C(200,0,0)
		b.Text=text
		b.TextColor3=WHITE
		b.Font=Enum.Font.GothamBold
		b.TextSize=15
		b.Parent=holder
		style(b)
		return b
	end
	local main=mkBtn(T("transform"),1)
	local bSlash=mkBtn(T("slash"),2)
	local bRoar=mkBtn(T("roar"),3)
	local bShoot=mkBtn(T("shoot"),4)
	local bRed=mkBtn(T("red"),5)
	local bBlue=mkBtn(T("blue"),6)
	local bFly=mkBtn(T("fly"),7)
	local skills={bSlash,bRoar,bShoot,bRed,bBlue,bFly}

	local function holdBtn(text,y,flag)
		local b=Instance.new("TextButton")
		b.AnchorPoint=Vector2.new(0,0.5)
		b.Position=UDim2.new(0,8,0.5,y)
		b.Size=UDim2.new(0,70,0,42)
		b.BackgroundColor3=C(200,0,0)
		b.Text=text
		b.TextColor3=WHITE
		b.Font=Enum.Font.GothamBold
		b.TextSize=16
		b.Visible=false
		b.Parent=gui
		style(b)
		local function press(i,on)
			if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
				S[flag]=on
			end
		end
		b.InputBegan:Connect(function(i) press(i,true) end)
		b.InputEnded:Connect(function(i) press(i,false) end)
		return b
	end
	local bUp=holdBtn(T("up"),-26,"up")
	local bDown=holdBtn(T("down"),26,"down")

	local function sync()
		local on=S.active
		for _,b in ipairs(skills) do b.Visible=on end
		bUp.Visible=on and S.fly
		bDown.Visible=on and S.fly
		main.Text=on and T("cancel") or T("transform")
		bFly.Text=S.fly and T("land") or T("fly")
	end

	local function cleanup()
		stopFly(false)
		S.up,S.down=false,false
		if S.conn then S.conn:Disconnect() S.conn=nil end
		if R.model then R.model:Destroy() R.model=nil end
		R.joints,R.parts,R.fl={},{},{}
		R.shown=false
		R.swordFx=nil
		act.name=nil
		S.saved={}
		S.active=false
		S.busy=false
		S.fa=0
		sync()
	end

	local function revert()
		if S.busy then return end
		if S.fly then stopFly() end
		local char=player.Character
		local hum=char and char:FindFirstChildOfClass("Humanoid")
		if char then hideChar(char,false) end
		if hum then
			hum.HipHeight=S.old.hip or 0
			hum.WalkSpeed=S.old.speed or 16
			hum.CameraOffset=S.old.coff or Vector3.new()
			hum.DisplayDistanceType=S.old.nd or Enum.HumanoidDisplayDistanceType.Viewer
		end
		player.CameraMaxZoomDistance=S.old.zmax or 128
		player.CameraMinZoomDistance=S.old.zmin or 0.5
		cleanup()
	end

	local function doFly()
		if not S.active or S.busy then return end
		if S.fly then stopFly() else startFly() end
		sync()
	end

	main.MouseButton1Click:Connect(function()
		if S.busy then return end
		if S.active then
			revert()
		else
			transform()
			sync()
		end
	end)
	bSlash.MouseButton1Click:Connect(function() playAction("slash") end)
	bRoar.MouseButton1Click:Connect(function() playAction("roar") end)
	bShoot.MouseButton1Click:Connect(function() playAction("shoot") end)
	bRed.MouseButton1Click:Connect(function() playAction("red") end)
	bBlue.MouseButton1Click:Connect(function() playAction("blue") end)
	bFly.MouseButton1Click:Connect(doFly)

	UIS.InputBegan:Connect(function(i,gp)
		if gp or not S.active then return end
		local k=i.KeyCode
		if k==Enum.KeyCode.Q then playAction("slash")
		elseif k==Enum.KeyCode.E then playAction("roar")
		elseif k==Enum.KeyCode.R then playAction("shoot")
		elseif k==Enum.KeyCode.T then playAction("red")
		elseif k==Enum.KeyCode.Y then playAction("blue")
		elseif k==Enum.KeyCode.F then doFly()
		end
	end)
	player.CharacterAdded:Connect(cleanup)
end

chooseLang(function() loading(startMain) end)
