local function sfx(id,vol,speed,loop)
	if not id or id=="" then return end
	local s=Instance.new("Sound")
	s.SoundId=id
	s.Volume=vol or 1
	s.PlaybackSpeed=speed or 1
	s.Looped=loop or false
	s.Parent=workspace
	s:Play()
	if not loop then Debris:AddItem(s,8) end
	return s
end

local function tw(o,t,p,style)
	local x=TweenService:Create(o,TweenInfo.new(t,style or Enum.EasingStyle.Sine),p)
	x:Play()
	return x
end

local function scl(c)
	local p=c.Position
	return CFrame.new(p*K)*(c-p)
end

local function emitter(parent,tex,color,size,rate,life,speed,light)
	local e=Instance.new("ParticleEmitter")
	e.Texture=tex
	e.Color=ColorSequence.new(color)
	e.Size=NumberSequence.new(size[1],size[2])
	e.Transparency=NumberSequence.new({
		NumberSequenceKeypoint.new(0,1),
		NumberSequenceKeypoint.new(0.2,light and 0 or 0.25),
		NumberSequenceKeypoint.new(1,1)})
	e.Rate=rate
	e.Lifetime=NumberRange.new(life,life+1)
	e.Speed=NumberRange.new(speed,speed*2)
	e.SpreadAngle=Vector2.new(180,180)
	e.Acceleration=Vector3.new(0,6,0)
	e.RotSpeed=NumberRange.new(-40,40)
	e.LightEmission=light and 1 or 0
	e.Parent=parent
	return e
end-- (2/13)
