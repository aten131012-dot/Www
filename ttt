local function subtitle(text,dur)
	local pg=player:WaitForChild("PlayerGui")
	if not subLbl or not subLbl.Parent then
		local g=Instance.new("ScreenGui")
		g.Name="NexoraSub"
		g.ResetOnSpawn=false
		g.DisplayOrder=50
		g.Parent=pg
		subLbl=Instance.new("TextLabel")
		subLbl.AnchorPoint=Vector2.new(0.5,1)
		subLbl.Position=UDim2.new(0.5,0,0.92,0)
		subLbl.Size=UDim2.new(0.8,0,0,40)
		subLbl.BackgroundColor3=C(0,0,0)
		subLbl.BackgroundTransparency=0.4
		subLbl.TextColor3=C(220,170,255)
