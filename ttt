local function skillShoot()
	local muz=R.parts.Muzzle
	if not muz then return end
	speak(V_ORB)
	local BALL=16*K
	sfx(SND.charge,1.8,0.5)
	local ball=orb(PURPLE,0)
	local halo=orb(C(110,40,255),0.55)
	local core=orb(C(245,225,255),0.05)
	local lt=Instance.new("PointLight")
	lt.Color=PURPLE
	lt.Range=20
	lt.Brightness=5
	lt.Parent=ball
	local em=emitter(ball,SPARK,PURPLE,{3*K,0},80,0.6,14,true)
	em.Acceleration=Vector3.new()
	pcall(function()
		em.Shape=Enum.ParticleEmitterShape.Sphere
		em.ShapeInOut=Enum.ParticleEmitterShapeInOut.Inward
		em.ShapeStyle=Enum.ParticleEmitterShapeStyle.Surface
	end)
	local function place(pos,d)
		ball.Size=Vector3.new(d,d,d)
		halo.Size=Vector3.new(d*1.45,d*1.45,d*1.45)
		core.Size=Vector3.new(d*0.55,d*0.55,d*0.55)
		ball.Position=pos
		halo.Position=pos
		core.Position=pos
	end
	-- ชาร์จบอลหน้าปากกระบอก
	local CH=1.5
	local t0=os.clock()
	while os.clock()-t0<CH and R.model and muz.Parent do
		local k=(os.clock()-t0)/CH
		local d=BALL*(0.08+0.92*k*k)
		place(muz.Position-muz.CFrame.RightVector*(d*0.5+2*K),d)
		lt.Range=math.min(60,16+40*k)
		task.wait()
	end
	if not (R.model and muz.Parent) then
		ball:Destroy()
		halo:Destroy()
		core:Destroy()
		return
	end
	-- ยิงไปข้างหน้าตามทิศกล้อง
	local pos=ball.Position
	local params=RaycastParams.new()
	params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances={player.Character,R.model,ball,halo,core}
	local o,lk=cam.CFrame.Position,cam.CFrame.LookVector
	local r0=workspace:Raycast(o,lk*800,params)
	local target=r0 and r0.Position or (o+lk*800)
	local dir=target-pos
	dir=dir.Magnitude>1 and dir.Unit or lk
	sfx(SND.shoot,2.2,1.1)
	sfx(SND.boom,1.2,1.5)
	em.Rate=140
	local hit=false
	local life=0
	while life<4 and not hit do
		local dt=task.wait()
		life=life+dt
		local step=dir*230*dt
		local res=workspace:Raycast(pos,step+dir*(BALL*0.5),params)
		if res then
			pos=res.Position
			hit=true
		else
			pos=pos+step
		end
		place(pos,BALL)
	end
	blast(pos,BALL*3,PURPLE)
	ball:Destroy()
	halo:Destroy()
	core:Destroy()
end

local function playAction(name,force)
	if act.name or (not force and not S.active) then return end
	act.name=name
	act.t=0
	act.fire=0
	act.pitch=0
	if name=="slash" then
		act.dur=1.1
		task.delay(0.33,function() sfx(SND.slash,1.6,0.7) end)
		task.delay(0.55,function()
			sfx(SND.slash,1.6,0.55)
			local g,f=groundAhead()
			if g then
				ring(g+f*30*K,0,50*K,PURPLE)
				shakeCam(0.35,1)
			end
		end)
	elseif name=="roar" then
		act.dur=2.6
		sfx(SND.roar,2,0.55)
		sfx(SND.boom,1,0.8)
		if R.coreLight then
			tw(R.coreLight,0.6,{Brightness=8})
			task.delay(1.8,function()
				if R.coreLight then tw(R.coreLight,0.8,{Brightness=2}) end
			end)
		end
		if not force then
			if R.setFace then R.setFace("mad") end
			shakeCam(2,1)
			task.delay(2.6,function() if R.setFace then R.setFace("calm") end end)
		end
	elseif name=="shoot" then
		act.dur=2.7
		act.fire=1.5
		local look=cam.CFrame.LookVector
		act.pitch=math.clamp(math.asin(math.clamp(look.Y,-1,1)),-0.5,0.7)
		local rt=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local fl=Vector3.new(look.X,0,look.Z)
		if rt and not S.fly and fl.Magnitude>0.05 then
			rt.CFrame=CFrame.lookAt(rt.Position,rt.Position+fl)
		end
		task.spawn(skillShoot)
	elseif name=="red" then
		act.dur=3.4
		task.spawn(skillRed)
	elseif name=="blue" then
		act.dur=3.2
		task.spawn(skillLight)
	end
end-- (12/13) คัทซีนแปลงร่าง
local function transform()
	local char=player.Character
	local hum=char and char:FindFirstChildOfClass("Humanoid")
	local root=char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or S.busy then return end
	S.busy=true
	local o=S.old
	o.hip,o.speed=hum.HipHeight,hum.WalkSpeed
	o.zmax,o.zmin,o.coff=player.CameraMaxZoomDistance,player.CameraMinZoomDistance,hum.CameraOffset
	o.nd=hum.DisplayDistanceType
	local fog={Lighting.FogColor,Lighting.FogStart,Lighting.FogEnd,Lighting.Ambient,Lighting.OutdoorAmbient,Lighting.Brightness}
	local f=root.CFrame.LookVector*Vector3.new(1,0,1)
	f=f.Magnitude>0 and f.Unit or Vector3.new(0,0,-1)
	local ground=root.Position-Vector3.new(0,o.hip+root.Size.Y/2,0)
	root.Anchored=true

	-- 1) หมอกดำ
	sfx(SND.fog,1.2,0.6)
	local cc=Instance.new("ColorCorrectionEffect")
	cc.Parent=Lighting
	tw(Lighting,2,{FogColor=C(0,0,0),FogStart=0,FogEnd=90*K,Ambient=C(10,10,14),OutdoorAmbient=C(10,10,14),Brightness=0.4})
	tw(cc,2,{Brightness=-0.15,Contrast=0.25,Saturation=-0.4})
	cam.CameraType=Enum.CameraType.Scriptable
	cam.CFrame=CFrame.lookAt(ground+f*34*K+Vector3.new(8,3,0)*K,ground+Vector3.new(0,6,0)*K)
	local sp=Instance.new("Part")
	sp.Anchored=true
	sp.CanCollide=false
	sp.CanQuery=false
	sp.Transparency=1
	sp.Size=Vector3.new(26,1,26)*K
	sp.Position=ground
	sp.Parent=workspace
	local smoke=emitter(sp,SMOKE,C(0,0,0),{12*K,26*K},70,3,5,false)
	local sparks=emitter(sp,SPARK,PURPLE,{0.8*K,0},45,1.2,12,true)
	task.wait(2)

	-- 2) ร่างปรากฏจากเท้าขึ้นหัว + เสียงพูดแรก
	root.CFrame=root.CFrame+Vector3.new(0,HIP-o.hip,0)
	hum.HipHeight=HIP
	local model=buildTitan(root)
	hideChar(char,true)
	hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
	animate(root,hum)
	task.wait(0.2)
	sfx(SND.boom,1.5,0.5)
	ring(ground,0,70*K)
	ring(ground,0.4,110*K)
	for _,p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") and p.Name~="Base" then
			local tr=p:GetAttribute("T") or 0
			if tr<1 then
				local h=math.clamp((p.Position.Y-ground.Y)/(30*K),0,1)
				task.delay(h*2.2,function()
					if p.Parent then tw(p,0.5,{Transparency=tr}) end
				end)
			end
		end
	end
	for _,d in ipairs(model:GetDescendants()) do
		if d:IsA("Light") or d:IsA("Highlight") then d.Enabled=true end
	end
	task.delay(2.2,function()
		if R.faceGui then R.faceGui.Enabled=true end
	end)
	task.delay(3.2,function()
		R.shown=true
		if R.swordFx then R.swordFx.Enabled=true end
	end)
	tw(cam,3.2,{CFrame=CFrame.lookAt(ground+f*40*K+Vector3.new(0,14,0)*K,ground+Vector3.new(0,17,0)*K)},Enum.EasingStyle.Quad)
	task.delay(1.5,function() speak(V_ARRIVE) end)
	task.wait(3.2)

	-- 3) ซูมหน้าจอ ยิ้มกวน แล้วคำราม
	R.setFace("smirk")
	sfx(SND.glitch,1,0.5)
	tw(cam,1.2,{CFrame=CFrame.lookAt(ground+f*17*K+Vector3.new(0,25,0)*K,ground+Vector3.new(0,25.5,0)*K)},Enum.EasingStyle.Quint)
	task.wait(1.5)
	R.setFace("mad")
	playAction("roar",true)
	speak(V_ROAR)
	local base=cam.CFrame
	local t0=os.clock()
	while os.clock()-t0<2.4 do
		cam.CFrame=base*CFrame.new(math.random(-8,8)/25*K,math.random(-8,8)/25*K,0)
		task.wait()
	end
	R.setFace("smirk")
	tw(cam,1.5,{CFrame=CFrame.lookAt(ground+f*38*K+Vector3.new(0,12,0)*K,ground+Vector3.new(0,16,0)*K)})
	speak(V_END)
	task.wait(2.2)

	-- 4) จบคัทซีน
	R.setFace("calm")
	tw(Lighting,2.5,{FogColor=fog[1],FogStart=fog[2],FogEnd=fog[3],Ambient=fog[4],OutdoorAmbient=fog[5],Brightness=fog[6]})
	tw(cc,2.5,{Brightness=0,Contrast=0,Saturation=0})
	smoke.Enabled=false
	sparks.Enabled=false
	cam.CameraType=Enum.CameraType.Custom
	cam.CameraSubject=hum
	root.Anchored=false
	hum.WalkSpeed=WALK
	hum.CameraOffset=Vector3.new(0,CAMY,0)
	player.CameraMinZoomDistance=30*K
	player.CameraMaxZoomDistance=120*K
	emitter(R.parts.Base,SMOKE,C(0,0,0),{8*K,14*K},8,2.5,3,false)
	Debris:AddItem(sp,5)
	Debris:AddItem(cc,3)
	S.active=true
	S.busy=false
end-- (13/13) UI + ปุ่มควบคุม
