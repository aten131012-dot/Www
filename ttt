-- เสียงพูดอังกฤษทุ้มลึก (TTS ของ Roblox + ลดพิตช์)
local function speak(v)
	local dur=#v.en*0.075+0.8
	R.talk=os.clock()+dur
	subtitle(LANG=="TH" and v.th or v.en,dur+0.6)
	task.spawn(function()
		if VOICE_ID~="" then sfx(VOICE_ID,2,1) return end
		local ok=pcall(function()
			local tts=Instance.new("AudioTextToSpeech")
			tts.Text=v.en
			tts.VoiceId="1"
			tts.Parent=workspace
			local ps=Instance.new("AudioPitchShifter")
			ps.Pitch=0.6
			ps.Parent=workspace
			local out=Instance.new("AudioDeviceOutput")
			out.Parent=workspace
			local w1=Instance.new("Wire")
			w1.SourceInstance=tts
			w1.TargetInstance=ps
			w1.Parent=workspace
			local w2=Instance.new("Wire")
			w2.SourceInstance=ps
			w2.TargetInstance=out
			w2.Parent=workspace
			for _,x in ipairs({tts,ps,out,w1,w2}) do Debris:AddItem(x,dur+5) end
			local t0=os.clock()
			repeat task.wait(0.1) until tts.TimeLength>0 or os.clock()-t0>3
			tts:Play()
		end)
		if not ok then sfx(SND.glitch,1,0.4) end
	end)
end-- (3/13) ขา + เสื้อโค้ทดำสนิท
local function limb(name,size,color,mat,parent,c0,c1,class)
	local p=Instance.new(class or "Part")
	p.Name=name
	p.Size=size*K
	p.Color=color
	p.Material=mat or Enum.Material.SmoothPlastic
	p.Massless=true
	p.CanCollide=false
	p.CanQuery=false
	p.CanTouch=false
	p.Transparency=1
	p.Parent=R.model
	local w=Instance.new("Weld")
	w.Name=name.."_J"
	w.Part0=parent
	w.Part1=p
	w.C0=scl(c0)
	w.C1=scl(c1 or CFrame.new())
	w.Parent=p
	R.joints[name]=w
	R.parts[name]=p
	return p
end

