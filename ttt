local function shakeCam(dur,amt)
	task.spawn(function()
		local ch=player.Character
		local hum=ch and ch:FindFirstChildOfClass("Humanoid")
		local t0=os.clock()
		while hum and os.clock()-t0<dur do
			hum.CameraOffset=Vector3.new(math.random(-8,8)/30*amt*K,CAMY+math.random(-8,8)/30*amt*K,0)
			task.wait()
		end
		if hum then hum.CameraOffset=Vector3.new(0,CAMY,0) end
	end)
