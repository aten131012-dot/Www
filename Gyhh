local Orig = {}

-- ═══ FPS overlay ═══
local FpsLabel = NX.label(NX.Gui, {
	BackgroundTransparency = 0.25, BackgroundColor3 = THEME.Bg, Position = UDim2.fromOffset(10, 10),
	Size = UDim2.fromOffset(170, 24), Font = Enum.Font.GothamBold, Text = "FPS --  |  PING -- ms",
	TextXAlignment = Enum.TextXAlignment.Center, Visible = false, ZIndex = 50,
})
NX.corner(FpsLabel, 8)
NX.stroke(FpsLabel, THEME.Accent, 1, 0.4)

local frames, acc = 0, 0
local function fpsCounter(on)
	FpsLabel.Visible = on
	if on then
		frames, acc = 0, 0
		bind("ST_FPS", RunService.RenderStepped, function(dt)
			frames += 1
			acc += dt
			if acc >= 0.5 then
				local ping = 0
				pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5) end)
				FpsLabel.Text = string.format("FPS %d  |  PING %d ms", math.floor(frames / acc + 0.5), ping)
				frames, acc = 0, 0
			end
		end)
	else
		unbind("ST_FPS")
	end
end
NX.onDestroy(function() FpsLabel:Destroy() end)

-- ═══ Graphics ═══
local function fullbright(on)
	if on then
		if not Orig.Light then
			Orig.Light = {
				Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, GlobalShadows = Lighting.GlobalShadows,
				Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
			}
		end
		bind("ST_FULL", RunService.RenderStepped, function()
			Lighting.Brightness, Lighting.ClockTime, Lighting.GlobalShadows = 2, 14, false
			Lighting.Ambient = Color3.fromRGB(190, 190, 190)
			Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
		end)
	else
		unbind("ST_FULL")
		if Orig.Light then
			for k, v in pairs(Orig.Light) do Lighting[k] = v end
			Orig.Light = nil
		end
	end
end

local function noFog(on)
	if on then
		if not Orig.Fog then
			Orig.Fog = { FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart, Atmos = {} }
			for _, a in ipairs(Lighting:GetChildren()) do
				if a:IsA("Atmosphere") then Orig.Fog.Atmos[a] = { Density = a.Density, Haze = a.Haze } end
			end
		end
		bind("ST_FOG", RunService.RenderStepped, function()
			Lighting.FogEnd, Lighting.FogStart = 1e6, 1e5
			for _, a in ipairs(Lighting:GetChildren()) do
				if a:IsA("Atmosphere") then a.Density, a.Haze = 0, 0 end
			end
		end)
	else
		unbind("ST_FOG")
		if Orig.Fog then
			Lighting.FogEnd, Lighting.FogStart = Orig.Fog.FogEnd, Orig.Fog.FogStart
			for a, v in pairs(Orig.Fog.Atmos) do
				if a.Parent then a.Density, a.Haze = v.Density, v.Haze end
			end
			Orig.Fog = nil
		end
	end
end

local function customFov(on)
	if on then
		local cam = Workspace.CurrentCamera
		if cam and not Orig.FOV then Orig.FOV = cam.FieldOfView end
		bind("ST_FOV", RunService.RenderStepped, function()
			local c = Workspace.CurrentCamera
			if c then c.FieldOfView = State.FOV end
		end)
	else
		unbind("ST_FOV")
		local cam = Workspace.CurrentCamera
		if cam and Orig.FOV then cam.FieldOfView = Orig.FOV end
		Orig.FOV = nil
	end
end

local Boost = { Changed = {} }
local function fpsBoost(on)
	if on then
		Boost.Shadows = Lighting.GlobalShadows
		Lighting.GlobalShadows = false
		pcall(function()
			Boost.Quality = settings().Rendering.QualityLevel
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)
		for _, d in ipairs(Workspace:GetDescendants()) do
			if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
				if d.Enabled then
					Boost.Changed[#Boost.Changed + 1] = d
					d.Enabled = false
				end
			end
		end
	else
		if Boost.Shadows ~= nil then Lighting.GlobalShadows = Boost.Shadows end
		pcall(function() if Boost.Quality then settings().Rendering.QualityLevel = Boost.Quality end end)
		for _, d in ipairs(Boost.Changed) do
			if d.Parent then d.Enabled = true end
		end
		table.clear(Boost.Changed)
		Boost.Shadows, Boost.Quality = nil, nil
	end
end

