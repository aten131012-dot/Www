-- ═══════════ Pages / Tabs ═══════════
local Pages, TabButtons, CurrentPage = {}, {}, nil

function NX.switchPage(key)
	if CurrentPage == key or not Pages[key] then return end
	local old = CurrentPage
	CurrentPage = key
	for k, b in pairs(TabButtons) do b.setActive(k == key) end
	if old and Pages[old] then
		local o = Pages[old].Group
		tween(o, 0.12, { GroupTransparency = 1 })
		task.delay(0.13, function() if CurrentPage ~= old then o.Visible = false end end)
	end
	local n = Pages[key].Group
	n.Visible = true
	n.Position = UDim2.fromOffset(0, 16)
	n.GroupTransparency = 1
	tween(n, 0.28, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) },
		Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
end

function NX.removePage(key)
	local p = Pages[key]
	if not p then return end
	for i = #NX.Registry, 1, -1 do
		local e = NX.Registry[i]
		if e.owner == key then
			if e.get() then pcall(e.set, false, true) end
			table.remove(NX.Registry, i)
		end
	end
	p.Group:Destroy()
	TabButtons[key].btn:Destroy()
	Pages[key], TabButtons[key] = nil, nil
	if CurrentPage == key then CurrentPage = nil NX.switchPage("tab_home") end
end

