local Fly = {}
local function clearFly()
	if Fly.BV then Fly.BV:Destroy() Fly.BV = nil end
	if Fly.BG then Fly.BG:Destroy() Fly.BG = nil end
end
local function fly(on)
	if on then
		bind("PL_FLY", RunService.Heartbeat, function()
			local hum, root, cam = getHum(), getRoot(), Workspace.CurrentCamera
			if not hum or not root or not cam then return end
			if not Fly.BV or Fly.BV.Parent ~= root then
				clearFly()
				Fly.BV = create("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero }, root)
				Fly.BG = create("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 9e4, CFrame = root.CFrame }, root)
			end
			hum.PlatformStand = true
			local vel, move = Vector3.zero, hum.MoveDirection
			if move.Magnitude > 0 then
				local cf = cam.CFrame
				local rel = cf:VectorToObjectSpace(move)
				local dir = cf.RightVector * rel.X - cf.LookVector * rel.Z
				if dir.Magnitude > 0 then vel = dir.Unit * State.FlySpeed end
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel += Vector3.new(0, State.FlySpeed, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vel -= Vector3.new(0, State.FlySpeed, 0) end
			Fly.BV.Velocity = vel
			local look = cam.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 0.01 then
				Fly.BG.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
			end
		end)
	else
		unbind("PL_FLY")
		clearFly()
		local h = getHum()
		if h then h.PlatformStand = false end
	end
end

local function gravity(on)
	if on then
