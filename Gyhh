local acc, frames, lastHp, lastMax = 0, 0, -1, -1
NX.track(RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	for _, anim in ipairs(CatAnimators) do anim(t) end
	LogoHolder.Position = UDim2.fromOffset(0, math.sin(t * 2.2) * 3)
	local pulse = 0.5 + 0.5 * math.sin(t * 3)
	LogoRing.Transparency = 0.5 - 0.4 * pulse
	LogoRing.Thickness = 2 + 1.5 * pulse

	frames += 1
	acc += dt
	if acc >= 0.5 then
		fpsVal.Text = tostring(math.floor(frames / acc + 0.5))
		local ping = 0
		pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5) end)
		pingVal.Text = ping .. "ms"
		plrVal.Text = #Players:GetPlayers() .. "/" .. Players.MaxPlayers
		frames, acc = 0, 0
	end

	local h = getHum()
	local hp = h and math.floor(h.Health + 0.5) or 0
	local mhp = h and math.floor(h.MaxHealth + 0.5) or 0
	if hp ~= lastHp or mhp ~= lastMax then
		lastHp, lastMax = hp, mhp
		local pct = (mhp > 0) and math.clamp(hp / mhp, 0, 1) or 0
		hpText.Text = hp .. " / " .. mhp
		tween(hpFill, 0.15, {
			Size = UDim2.fromScale(pct, 1),
			BackgroundColor3 = Color3.fromRGB(230, 50, 60):Lerp(Color3.fromRGB(60, 220, 110), pct),
		})
	end
end))

