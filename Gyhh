local function scanNpc(inst)
	if inst:IsA("Humanoid") then
		local m = inst.Parent
		if m and m:IsA("Model") and m ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(m) then
			Npcs[m] = true
		end
	end
end

local function refresh()
	for model, o in pairs(Objs) do
		if not model.Parent or not o.hl.Parent
			or (o.isNpc and not Opt.NPC) or (not o.isNpc and not Opt.Players) then
			clear(model)
		end
	end
	if Opt.Players then
		for _, plr in ipairs(Players:GetPlayers()) do
			local ch = plr.Character
			if plr ~= LocalPlayer and ch and not Objs[ch] then build(ch, plr.DisplayName, false) end
		end
	end
	if Opt.NPC then
		for m in pairs(Npcs) do
			if not m.Parent then Npcs[m] = nil elseif not Objs[m] then build(m, m.Name, true) end
		end
	end
end

local function updateLabels()
	local root = NX.getRoot()
	for _, o in pairs(Objs) do
		local d = (root and o.head and o.head.Parent) and (root.Position - o.head.Position).Magnitude or 0
		local inRange = d <= Opt.Range
		o.hl.Enabled, o.bb.Enabled = inRange, inRange
		o.hl.FillColor = o.isNpc and NPC_COLOR or COLORS[Opt.ColorIdx][2]
		if inRange then
			local parts = {}
			if Opt.Name then parts[#parts + 1] = o.name end
			if Opt.HP and o.hum then parts[#parts + 1] = "HP " .. math.floor(o.hum.Health) end
			if Opt.Dist then parts[#parts + 1] = math.floor(d) .. "m" end
			o.lbl.Text = table.concat(parts, "  |  ")
			o.lbl.Visible = #parts > 0
		end
	end
end

local t1, t2 = 1, 1
local function syncLoop()
	if Opt.Players or Opt.NPC then
		t1, t2 = 1, 1
		NX.bind("ESP_LOOP", RunService.Heartbeat, function(dt)
			t1 += dt
			t2 += dt
			if t1 >= 1 then t1 = 0 refresh() end
			if t2 >= 0.2 then t2 = 0 updateLabels() end
		end)
	else
		NX.unbind("ESP_LOOP")
		for m in pairs(Objs) do clear(m) end
	end
end

