function NX.addToggle(scroll, nameKey, descKey, callback, opts)
	local state = false
	local row = NX.makeRow(scroll, 48, true)
	NX.rowTexts(row, nameKey, descKey, 76)
	local switch = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(42, 22), BackgroundColor3 = THEME.Off, BorderSizePixel = 0,
	}, row)
	corner(switch, 11)
	local knob = create("Frame", {
		Position = UDim2.fromOffset(3, 3), Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = THEME.White, BorderSizePixel = 0,
	}, switch)
	corner(knob, 8)
	local function set(v, silent)
		state = v and true or false
		tween(switch, 0.2, { BackgroundColor3 = state and THEME.Accent or THEME.Off })
		tween(knob, 0.2, { Position = state and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3) })
		local ok, err = pcall(callback, state)
		if not ok then warn("[NEXORA] " .. nameKey .. ": " .. tostring(err)) end
		if not silent then
			NX.notify(NX.L(nameKey) .. "  " .. (state and NX.L("on") or NX.L("off")))
		end
	end
	row.MouseButton1Click:Connect(function() set(not state) end)
	row.MouseEnter:Connect(function() tween(row, 0.15, { BackgroundColor3 = THEME.RowHover }) end)
	row.MouseLeave:Connect(function() tween(row, 0.15, { BackgroundColor3 = THEME.Row }) end)
	if not (opts and opts.noReset) then
		NX.Registry[#NX.Registry + 1] = {
			set = set, get = function() return state end, owner = scroll:GetAttribute("owner"),
		}
	end
	return set
end

function NX.addSlider(scroll, nameKey, min, max, default, step, onChange, suffix)
	suffix = suffix or ""
	local value = default
	local row = NX.makeRow(scroll, 58, false)
	local n = label(row, {
		Position = UDim2.fromOffset(12, 7), Size = UDim2.new(1, -90, 0, 18),
		Font = Enum.Font.GothamBold, TextSize = 14,
	})
	NX.bindText(n, nameKey)
	local valueLabel = label(row, {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 7),
		Size = UDim2.fromOffset(70, 18), Font = Enum.Font.GothamBold, TextSize = 13,
		TextColor3 = THEME.AccentSoft, TextXAlignment = Enum.TextXAlignment.Right,
	})
	local trk = create("Frame", {
		Position = UDim2.new(0, 12, 0, 40), Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = THEME.Off, BorderSizePixel = 0,
	}, row)
	corner(trk, 3)
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0 }, trk)
	corner(fill, 3)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14), BackgroundColor3 = THEME.White, BorderSizePixel = 0, ZIndex = 2,
	}, trk)
	corner(knob, 7)
	local hit = create("TextButton", {
		BackgroundTransparency = 1, Text = "", Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 30),
	}, row)
	local function render(v)
		local rel = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(rel, 1)
		knob.Position = UDim2.fromScale(rel, 0.5)
		valueLabel.Text = tostring(v) .. suffix
	end
	local function setFromX(x)
		local rel = math.clamp((x - trk.AbsolutePosition.X) / math.max(trk.AbsoluteSize.X, 1), 0, 1)
		local v = math.floor((min + (max - min) * rel) / step + 0.5) * step
		v = tonumber(string.format("%.2f", math.clamp(v, min, max)))
		if v ~= value then
			value = v
			render(v)
			local ok, err = pcall(onChange, v)
			if not ok then warn("[NEXORA] slider " .. nameKey .. ": " .. tostring(err)) end
		end
	end
	local dragging = false
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			scroll.ScrollingEnabled = false
			setFromX(input.Position.X)
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					scroll.ScrollingEnabled = true
					c:Disconnect()
				end
			end)
		end
	end)
	NX.track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end))
	render(default)
end

