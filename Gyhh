-- ═══════════ แมวโลโก้ ═══════════
local CatAnimators = {}
local function makeCat(parent, size, phase)
	phase = phase or 0
	local root = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size) }, parent)
	local function ear(x)
		local e = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, 0.26),
			Size = UDim2.fromScale(0.3, 0.3), Rotation = 45, BackgroundColor3 = THEME.Accent,
			BorderSizePixel = 0, ZIndex = 1,
		}, root)
		corner(e, 0.18)
		local inner = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(60, 8, 16),
			BorderSizePixel = 0, ZIndex = 2,
		}, e)
		corner(inner, 0.2)
		return e
	end
	local earL = ear(0.27)
	ear(0.73)
	local head = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.58),
		Size = UDim2.fromScale(0.8, 0.62), BackgroundColor3 = Color3.fromRGB(14, 14, 18),
		BorderSizePixel = 0, ZIndex = 3,
	}, root)
	corner(head, 0.42)
	stroke(head, THEME.Accent, math.max(1.5, size / 26), 0)
	local function eye(x)
		local e = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, 0.55),
			Size = UDim2.fromScale(0.15, 0.2), BackgroundColor3 = THEME.AccentSoft,
			BorderSizePixel = 0, ZIndex = 4,
		}, root)
		corner(e, 0.5)
		local p = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.3, 0.8), BackgroundColor3 = Color3.fromRGB(10, 0, 0),
			BorderSizePixel = 0, ZIndex = 5,
		}, e)
		corner(p, 0.5)
		return e
	end
	local eyeL, eyeR = eye(0.36), eye(0.64)
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.68),
		Size = UDim2.fromScale(0.08, 0.05), BackgroundColor3 = Color3.fromRGB(255, 120, 135),
		BorderSizePixel = 0, ZIndex = 4,
	}, root)
	local function whisker(x, y, rot)
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y),
			Size = UDim2.new(0.2, 0, 0, 1), Rotation = rot, BorderSizePixel = 0,
			BackgroundColor3 = Color3.fromRGB(210, 210, 220), BackgroundTransparency = 0.35, ZIndex = 4,
		}, root)
	end
	whisker(0.15, 0.66, 8) whisker(0.15, 0.72, -8) whisker(0.85, 0.66, -8) whisker(0.85, 0.72, 8)

	CatAnimators[#CatAnimators + 1] = function(t)
		local ph = (t + phase) % 4
		local h = (ph > 3.7 and ph < 3.85) and 0.03 or 0.2
		eyeL.Size, eyeR.Size = UDim2.fromScale(0.15, h), UDim2.fromScale(0.15, h)
		local col = THEME.Accent:Lerp(Color3.fromRGB(255, 150, 110), (0.5 + 0.5 * math.sin(t * 3 + phase)) * 0.6)
		eyeL.BackgroundColor3, eyeR.BackgroundColor3 = col, col
		if ph > 1.5 and ph < 1.7 then
			earL.Rotation = 45 - 12 * math.sin((ph - 1.5) / 0.2 * math.pi)
		else
			earL.Rotation = 45
		end
	end
	return root
end

-- ═══════════ ระบบลาก (เมาส์ + ทัช) ═══════════
local function makeDraggable(handle, target, getScale, onClick)
	local dragging, moved, dragStart, startPos = false, false, nil, nil
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved = true, false
			dragStart, startPos = input.Position, target.Position
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					c:Disconnect()
					dragging = false
					if not moved and onClick then onClick() end
				end
			end)
		end
	end)
	NX.track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			if d.Magnitude > 8 then moved = true end
			if moved then
				local s = math.max(getScale(), 0.1)
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X / s,
					startPos.Y.Scale, startPos.Y.Offset + d.Y / s)
			end
		end
	end))
end

