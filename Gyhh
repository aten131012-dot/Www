local function applyScale()
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	BaseScale = math.clamp(math.min(vp.X / (W + 60), vp.Y / (H + 60)), 0.5, 1.15) * UserScale
	if WindowOpen then WinScale.Scale = BaseScale end
	LogoScale.Scale = math.clamp(BaseScale, 0.75, 1.25)
	ToastScale.Scale = math.clamp(BaseScale, 0.8, 1.2)
end
local function setWindow(open)
	if open == WindowOpen then return end
	WindowOpen = open
	if open then
		Window.Visible = true
		WinScale.Scale = BaseScale * 0.85
		Window.GroupTransparency = 1
		tween(WinScale, 0.35, { Scale = BaseScale }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		tween(Window, 0.25, { GroupTransparency = 0 })
	else
		tween(WinScale, 0.2, { Scale = BaseScale * 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(Window, 0.2, { GroupTransparency = 1 })
		task.delay(0.22, function() if not WindowOpen then Window.Visible = false end end)
	end
end
function NX.setUserScale(v) UserScale = v applyScale() end
function NX.resetPositions() Window.Position = DEFAULT_WINDOW_POS Logo.Position = DEFAULT_LOGO_POS end
