local function stopFly()
	if not S.fly then return end
	S.fly=false
	S.up,S.down=false,false
	if flyConn then flyConn:Disconnect() flyConn=nil end
	local ch=player.Character
	local hum=ch and ch:FindFirstChildOfClass("Humanoid")
	local root=ch and ch:FindFirstChild("HumanoidRootPart")
	for _,o in ipairs({S.lv,S.ao,S.att,S.jetSnd}) do
		if o then o:Destroy() end
	end
	S.lv,S.ao,S.att,S.jetSnd=nil,nil,nil,nil
	if root then
		local _,yaw=root.CFrame:ToEulerAnglesYXZ()
		root.CFrame=CFrame.new(root.Position)*CFrame.Angles(0,yaw,0)
		root.AssemblyAngularVelocity=Vector3.zero
	end
	if hum then
		hum.PlatformStand=false
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

local function startFly()
	local ch=player.Character
	local hum=ch and ch:FindFirstChildOfClass("Humanoid")
	local root=ch and ch:FindFirstChild("HumanoidRootPart")
	if not hum or not root or S.fly or not S.active then return end
	S.fly=true
	hum.PlatformStand=true
	local att=Instance.new("Attachment")
	att.Parent=root
	local lv=Instance.new("LinearVelocity")
	lv.Attachment0=att
	lv.MaxForce=math.huge
	lv.RelativeTo=Enum.ActuatorRelativeTo.World
	lv.VectorVelocity=Vector3.new(0,FLY_SPEED*0.2,0)
	lv.Parent=root
	local ao=Instance.new("AlignOrientation")
	ao.Mode=Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0=att
	ao.RigidityEnabled=true
	ao.CFrame=root.CFrame.Rotation
	ao.Parent=root
	local js=Instance.new("Sound")
	js.SoundId=SND.jet
	js.Looped=true
	js.Volume=1.2
	js.PlaybackSpeed=0.8
	js.Parent=root
	js:Play()
	S.att,S.lv,S.ao,S.jetSnd=att,lv,ao,js
	sfx(SND.boom,1,1.2)
	flyConn=RunService.Heartbeat:Connect(function()
		if not S.fly or not root.Parent then return end
		local dir
		if ctrl then
			local m=ctrl:GetMoveVector()
			dir=cam.CFrame:VectorToWorldSpace(Vector3.new(m.X,0,m.Z))
		else
			dir=hum.MoveDirection
		end
		local vy=(S.up and 1 or 0)-(S.down and 1 or 0)
		lv.VectorVelocity=dir*FLY_SPEED+Vector3.new(0,vy*FLY_SPEED*0.7,0)
		local look=cam.CFrame.LookVector
		local flat=Vector3.new(look.X,0,look.Z)
		if flat.Magnitude>0.01 then
			local lean=math.clamp(dir.Magnitude,0,1)*0.55
			ao.CFrame=CFrame.lookAt(Vector3.zero,flat.Unit)*CFrame.Angles(-lean,0,0)
		end
	end)
end-- (7) สกิล
