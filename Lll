		local hum=ch and ch:FindFirstChildOfClass("Humanoid")
		local t0=os.clock()
		while hum and os.clock()-t0<d and cam.CameraType==Enum.CameraType.Custom do
			hum.CameraOffset=Vector3.new(math.random(-10,10)/10*amt,CAMY+math.random(-10,10)/10*amt,0)
