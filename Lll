local function P(x,y,z) return CFrame.new(x*K,y*K,z*K) end

local function slashAng(k)
	if k<0.3 then return -2.3*(k/0.3)
	elseif k<0.5 then return -2.3+4.0*((k-0.3)/0.2)
	else return 1.7*(1-(k-0.5)/0.5) end
end
local function slamAng(k)
	if k<0.45 then return -2.8*(k/0.45)
	elseif k<0.6 then return -2.8+4*((k-0.45)/0.15)
	else return 1.2*(1-(k-0.6)/0.4) end
end

local ph,sgn=0,1
local function animate(root,hum)
	if S.conn then S.conn:Disconnect() end
	S.conn=RunService.RenderStepped:Connect(function(dt)
		if not R.model or not R.model.Parent then return end
		local J,Pt=R.joints,R.parts
		local t=os.clock()
		local v=root.AssemblyLinearVelocity
		local sp=Vector3.new(v.X,0,v.Z).Magnitude/K
		local fl=S.fly and 1 or 0
		local a=S.fly and 0 or math.clamp(sp/22,0,1)
		ph=ph+dt*(1.5+sp*0.2)
		local s,c=math.sin(ph),math.cos(ph)
		-- ขา
		J.ULegL.C0=P(-2.3,12,0)*CFrame.Angles(s*0.6*a-0.15*fl,0,0)
		J.ULegR.C0=P(2.3,12,0)*CFrame.Angles(-s*0.6*a-0.15*fl,0,0)
		J.LLegL.C0=P(0,-3,0)*CFrame.Angles(-math.max(0,c)*0.9*a-0.35*fl,0,0)
		J.LLegR.C0=P(0,-3,0)*CFrame.Angles(-math.max(0,-c)*0.9*a-0.35*fl,0,0)
		J.Pelvis.C0=P(0,12.2+math.abs(s)*0.35*a+math.sin(t*1.5)*0.05,0)
		-- แขน
		local aL,aR=-s*0.5*a-0.4*fl,s*0.5*a-0.4*fl
		local zL,zR=-0.1+math.sin(t*1.5)*0.02,0.1-math.sin(t*1.5)*0.02
		local eL,eR=0.25+0.25*a,0.25+0.25*a
		local ht,tt,ty=0,0,0
		if act.name then
			act.t=act.t+dt
			local k=act.t/act.dur
			if k>=1 then
				act.name=nil
			elseif act.name=="slash" then
				aR=slashAng(k)
				aL=0.3
				eL,eR=0.6,0.1
				ty=-math.sin(k*math.pi)*0.5
			elseif act.name=="laser" then
				local b=math.min(1,k*5,(1-k)*5)
				aL,aR=0.9*b,0.9*b
				eL,eR=0.2,0.2
				tt=0.15*b
			elseif act.name=="slam" then
				aL,aR=slamAng(k),slamAng(k)
				eL,eR=0.2,0.2
				tt=-0.35*math.sin(k*math.pi)
			else
				local b=math.sin(k*math.pi)
				aL,aR=-0.3*b,-0.3*b
				zL,zR=-1.1*b,1.1*b
				eL,eR=0.4*b,0.4*b
				ht,tt=0.55*b,0.2*b
			end
		end
		J.ArmL.C0=P(-5.9,3.6,0)*CFrame.Angles(aL,0,zL)
		J.ArmR.C0=P(5.9,3.6,0)*CFrame.Angles(aR,0,zR)
		J.ForeL.C0=P(0,-2.7,0)*CFrame.Angles(eL,0,0)
		J.ForeR.C0=P(0,-2.7,0)*CFrame.Angles(eR,0,0)
		J.Torso.C0=P(0,1.2+math.sin(t*1.5)*0.08,0)*CFrame.Angles(-0.07*a+tt,s*0.1*a+ty,0)
		J.Head.C0=P(0,4.4,0)*CFrame.Angles(ht+math.sin(t*0.7)*0.03,math.sin(t*0.5)*0.07,0)
		-- โค้ท
		local sw=math.sin(t*2)*0.03
		J.CoatFL.C0=P(-2.3,13.4,-2.6)*CFrame.Angles(math.max(0,s)*0.55*a+sw,0,0)
		J.CoatFR.C0=P(2.3,13.4,-2.6)*CFrame.Angles(math.max(0,-s)*0.55*a+sw,0,0)
		J.CoatB.C0=P(0,13.4,2.6)*CFrame.Angles(-0.1-a*0.4-fl*0.5-sw,0,0)
		J.CoatSL.C0=P(-4.8,13.4,0)*CFrame.Angles(0,0,-0.06-a*0.15-sw)
		J.CoatSR.C0=P(4.8,13.4,0)*CFrame.Angles(0,0,0.06+a*0.15+sw)
		-- แกนม่วง เฟือง
		local cs=(1.8+0.2*math.sin(t*4))*K
		Pt.Core.Size=Vector3.new(cs,cs,cs)
		R.coreLight.Range=(22+math.sin(t*4)*4)*K
		J.Gear.C0=sc(R.gear0)*CFrame.Angles(t*1.2,0,0)
		if R.shown then
			Pt.BladeGlowR.Transparency=0.1+0.15*math.sin(t*5)
			Pt.BladeAura.Transparency=0.7+0.12*math.sin(t*3)
		end
		-- เปลวไฟแจ็คแพ็ค
		for _,n in ipairs({"L","R"}) do
			local fo,fi=Pt["FlameO"..n],Pt["FlameI"..n]
			if S.fly then
				fo.Transparency=0.25+math.random()*0.2
				fi.Transparency=0.1
				fo.Size=Vector3.new(2.4,6+math.random()*2.5,2.4)*K
			else
				fo.Transparency=1
				fi.Transparency=1
			end
		end
		for _,e in ipairs(R.flameEm) do e.Rate=S.fly and 90 or 0 end
		-- ฝีเท้า
		local sg=s>=0 and 1 or -1
		if sg~=sgn then
			sgn=sg
			if a>0.35 then
				sfx(SND.step,0.7,0.5)
				hum.CameraOffset=Vector3.new(0,CAMY-0.35*K,0)
				tw(hum,0.2,{CameraOffset=Vector3.new(0,CAMY,0)})
			end
		end
	end)
end-- (6b) บิน
