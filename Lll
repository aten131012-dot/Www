local function playAction(name,force)
	if act.name or (not force and not S.active) then return end
	act.name=name
	act.t=0
	act.dur=DUR[name]
	if name=="slash" then
		task.delay(0.33,function()
			sfx(SND.slash,1.5,0.7)
			if R.shown then slashWave() end
		end)
	elseif name=="roar" then
		sfx(SND.roar,2,0.55)
		sfx(SND.boom,1,0.8)
		if R.coreLight then
			tw(R.coreLight,0.6,{Brightness=8})
			task.delay(1.8,function()
				if R.coreLight then tw(R.coreLight,0.8,{Brightness=2}) end
			end)
		end
		if not force then shake(2,0.3*K) end
	elseif name=="laser" then
		laser()
	elseif name=="slam" then
		sfx(SND.fog,1,0.8)
		task.delay(0.75,slam)
	end
