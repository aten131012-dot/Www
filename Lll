local function buildFace()
	local sc=R.parts.Screen
	local g=Instance.new("SurfaceGui")
	g.Face=Enum.NormalId.Front
	g.SizingMode=Enum.SurfaceGuiSizingMode.FixedSize
	g.CanvasSize=Vector2.new(800,520)
	g.LightInfluence=0
	g.Enabled=false
	g.Parent=sc
	R.faceGui=g
	R.faces={}
	local BK=C(0,0,0)
	local function fr(p,x,y,w,h,col,rot,round)
		local f=Instance.new("Frame")
		f.AnchorPoint=Vector2.new(0.5,0.5)
		f.Position=UDim2.fromScale(x,y)
		f.Size=UDim2.fromScale(w,h)
		f.BackgroundColor3=col
		f.BorderSizePixel=0
		f.Rotation=rot or 0
		if round then Instance.new("UICorner",f).CornerRadius=UDim.new(round,0) end
		f.Parent=p
		return f
	end
	local function new(name)
		local f=Instance.new("Frame")
		f.Size=UDim2.fromScale(1,1)
		f.BackgroundTransparency=1
		f.Visible=false
		f.Parent=g
		R.faces[name]=f
		return f
	end
	-- calm (หน้าเรียบเหมือนภาพแรก)
	local a=new("calm")
	local gr=C(60,60,80)
	fr(a,0.44,0.52,0.05,0.018,gr)
	fr(a,0.53,0.52,0.05,0.018,gr)
	fr(a,0.485,0.6,0.07,0.014,gr)
	-- smirk (ยิ้มกวน เหมือนภาพที่ 2)
	local b=new("smirk")
	fr(b,0.3,0.2,0.22,0.04,BK,-7,0.5)
	fr(b,0.7,0.2,0.22,0.04,BK,9,0.5)
	for _,x in ipairs({0.3,0.7}) do
		local e=fr(b,x,0.34,0.2,0.09,WHITE,0,0.5)
		local st=Instance.new("UIStroke",e)
		st.Thickness=4
		st.Color=BK
		fr(e,0.5,0.55,0.34,0.8,BK,0,0.5)
		fr(b,x,0.3,0.22,0.02,BK,0,0.5)
	end
	local m=fr(b,0.5,0.53,0.6,0.26,WHITE,0,0.5)
	m.AnchorPoint=Vector2.new(0.5,0)
	local ms=Instance.new("UIStroke",m)
	ms.Thickness=6
	ms.Color=BK
	R.mouthG=m
	local cv=fr(b,0.5,0.6,0.7,0.13,WHITE)
	cv.ZIndex=2
	local lip=fr(b,0.5,0.664,0.6,0.012,BK)
	lip.ZIndex=3
	-- mad (คำราม)
	local d=new("mad")
	fr(d,0.3,0.24,0.24,0.06,BK,24,0.5)
	fr(d,0.7,0.24,0.24,0.06,BK,-24,0.5)
	fr(d,0.3,0.4,0.07,0.1,BK,0,0.5)
	fr(d,0.7,0.4,0.07,0.1,BK,0,0.5)
	local mm=fr(d,0.5,0.7,0.5,0.22,BK,0,0.5)
	R.mouthM=mm
	fr(d,0.5,0.62,0.42,0.04,WHITE,0,0.2)
	new("blank")

	R.setFace=function(n)
		for k,v in pairs(R.faces) do v.Visible=(k==n) end
	end
	R.setFace("calm")
	-- ปากขยับตอนพูด
	task.spawn(function()
		while sc.Parent do
			local t=os.clock()
			if t<(R.talk or 0) then
				local k=math.abs(math.sin(t*13))
				R.mouthG.Size=UDim2.fromScale(0.6,0.2+0.18*k)
				R.mouthM.Size=UDim2.fromScale(0.5,0.12+0.2*k)
			else
				R.mouthG.Size=UDim2.fromScale(0.6,0.26)
				R.mouthM.Size=UDim2.fromScale(0.5,0.22)
			end
			task.wait()
		end
	end)
end-- (4c)
