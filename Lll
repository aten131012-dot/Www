local function laser()
	local core=R.parts.Core
	sfx(SND.charge,1.5,0.5)
	task.spawn(function()
		local function neon(col,tr,shape)
			local p=Instance.new("Part")
			p.Anchored=true
			p.CanCollide=false
			p.CanQuery=false
			p.CanTouch=false
			p.Material=Enum.Material.Neon
			p.Color=col
			p.Transparency=tr
			if shape then p.Shape=shape end
			p.Parent=workspace
			return p
		end
		local orb=neon(BLUE,0.2,Enum.PartType.Ball)
		local t0=os.clock()
		while os.clock()-t0<0.8 and core.Parent do
			local k=(os.clock()-t0)/0.8
			orb.Size=Vector3.one*(1+5*k)*K
			orb.CFrame=core.CFrame
			task.wait()
		end
		sfx(SND.laser,2,0.7)
		sfx(SND.boom,1,0.9)
		shake(1.2,0.5*K)
		local beams={neon(BLUE,0.3),neon(PURPLE,0.15),neon(WHITE,0)}
		local widths={7*K,4*K,1.8*K}
		local t1=os.clock()
		local lastHit
		while os.clock()-t1<1.2 and core.Parent do
			local k=(os.clock()-t1)/1.2
			local w=1-k^3
			local origin=core.Position
			local dir=-R.parts.Torso.CFrame.ZVector
			local hit=workspace:Raycast(origin,dir*400*K,rayParams())
			local len=hit and (hit.Position-origin).Magnitude or 400*K
			lastHit=hit and hit.Position or nil
			local mid=origin+dir*(len/2)
			for i,b in ipairs(beams) do
				b.Size=Vector3.new(widths[i]*w,widths[i]*w,len)
				b.CFrame=CFrame.lookAt(mid,mid+dir)
			end
			orb.CFrame=core.CFrame
			orb.Size=Vector3.one*6*K*(1-k*0.5)
			task.wait()
		end
		for _,b in ipairs(beams) do b:Destroy() end
		orb:Destroy()
		if lastHit then
			sfx(SND.slam,1.5,0.8)
			local ex=neon(PURPLE,0.2,Enum.PartType.Ball)
			ex.Size=Vector3.one*4*K
			ex.Position=lastHit
			tw(ex,0.8,{Size=Vector3.one*45*K,Transparency=1})
			Debris:AddItem(ex,1)
			fxRing(lastHit,0,70*K,BLUE)
		end
	end)
end

