local function sfx(id,vol,speed)
	if not id or id=="" then return end
	local s=Instance.new("Sound")
	s.SoundId=id
	s.Volume=vol or 1
	s.PlaybackSpeed=speed or 1
	s.Parent=workspace
	s:Play()
	Debris:AddItem(s,8)
end

local function tw(o,t,p,style)
	local x=TweenService:Create(o,TweenInfo.new(t,style or Enum.EasingStyle.Sine),p)
	x:Play()
	return x
