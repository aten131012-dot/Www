local function subtitle(text,dur)
	local pg=player:WaitForChild("PlayerGui")
	if not subLbl or not subLbl.Parent then
		local g=Instance.new("ScreenGui")
		g.Name="NexoraSub"
		g.ResetOnSpawn=false
		g.DisplayOrder=50
		g.Parent=pg
		subLbl=Instance.new("TextLabel")
		subLbl.AnchorPoint=Vector2.new(0.5,1)
		subLbl.Position=UDim2.new(0.5,0,0.92,0)
		subLbl.Size=UDim2.new(0.8,0,0,40)
		subLbl.BackgroundColor3=C(0,0,0)
		subLbl.BackgroundTransparency=0.4
		subLbl.TextColor3=C(220,170,255)
		subLbl.Font=Enum.Font.GothamBold
		subLbl.TextSize=22
		subLbl.TextWrapped=true
		subLbl.Parent=g
	end
	subLbl.Text=text
	subLbl.Visible=true
	local id=os.clock()
	subLbl:SetAttribute("id",id)
	task.delay(dur,function()
		if subLbl and subLbl:GetAttribute("id")==id then subLbl.Visible=false end
	end)
end

-- เสียงพูดอังกฤษทุ้มลึก (ใช้ TTS ของ Roblox + ลดพิตช์)
local function speak(v)
	local dur=#v.en*0.075+0.8
	R.talk=os.clock()+dur
	subtitle(LANG=="TH" and v.th or v.en,dur+0.6)
	task.spawn(function()
		if VOICE_ID~="" then sfx(VOICE_ID,2,1) return end
		local ok=pcall(function()
			local tts=Instance.new("AudioTextToSpeech")
			tts.Text=v.en
			tts.VoiceId="1"
			tts.Parent=workspace
			local ps=Instance.new("AudioPitchShifter")
			ps.Pitch=0.6
			ps.Parent=workspace
			local out=Instance.new("AudioDeviceOutput")
			out.Parent=workspace
			local w1=Instance.new("Wire")
			w1.SourceInstance=tts
			w1.TargetInstance=ps
			w1.Parent=workspace
			local w2=Instance.new("Wire")
			w2.SourceInstance=ps
			w2.TargetInstance=out
			w2.Parent=workspace
			for _,x in ipairs({tts,ps,out,w1,w2}) do Debris:AddItem(x,dur+5) end
			local t0=os.clock()
			repeat task.wait(0.1) until tts.TimeLength>0 or os.clock()-t0>3
			tts:Play()
		end)
		if not ok then sfx(SND.glitch,1,0.4) end
	end)
end-- (1c)
