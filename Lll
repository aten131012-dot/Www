local function startMain()
	local gui=mkGui("NexoraTitanTV",10)
	gui.IgnoreGuiInset=false
	local function mkBtn(text,col,y)
		local b=Instance.new("TextButton")
		b.AnchorPoint=Vector2.new(1,0.5)
		b.Position=UDim2.new(1,-8-col*128,0.5,y)
		b.Size=UDim2.new(0,120,0,46)
		b.BackgroundColor3=C(200,0,0)
		b.Text=text
		b.TextColor3=WHITE
		b.Font=Enum.Font.GothamBold
		b.TextSize=17
		b.Parent=gui
		style(b)
		return b
	end
	-- คอลัมน์ขวา: แปลงร่าง / บิน / ขึ้น / ลง
	local main=mkBtn(T("transform"),0,-84)
	local bFly=mkBtn(T("fly"),0,-28)
	local bUp=mkBtn(T("up"),0,28)
	local bDn=mkBtn(T("down"),0,84)
	-- คอลัมน์ซ้าย: สกิลสีแดง
	local bSlash=mkBtn(T("slash"),1,-84)
	local bLaser=mkBtn(T("laser"),1,-28)
	local bSlam=mkBtn(T("slam"),1,28)
	local bRoar=mkBtn(T("roar"),1,84)
	local skills={bFly,bSlash,bLaser,bSlam,bRoar}
	local function showSkills(v)
		for _,b in ipairs(skills) do b.Visible=v end
		bUp.Visible=v and S.fly
		bDn.Visible=v and S.fly
	end
	showSkills(false)

	local function flyUI()
		bFly.Text=S.fly and T("land") or T("fly")
		bUp.Visible=S.fly
		bDn.Visible=S.fly
	end
	local function toggleFly()
		if not S.active then return end
		if S.fly then stopFly() else startFly() end
		flyUI()
	end

	local function cleanup()
		stopFly()
		if S.conn then S.conn:Disconnect() S.conn=nil end
		if R.model then R.model:Destroy() R.model=nil end
		R.joints,R.parts,R.flameEm={}, {}, {}
		act.name=nil
		S.saved={}
		S.active=false
		S.busy=false
		main.Text=T("transform")
		bFly.Text=T("fly")
		showSkills(false)
	end

	local function revert()
		if S.busy then return end
		stopFly()
		local char=player.Character
		local hum=char and char:FindFirstChildOfClass("Humanoid")
		if char then hideChar(char,false) end
		if hum then
			hum.HipHeight=S.old.hip or 0
			hum.WalkSpeed=S.old.speed or 16
			hum.CameraOffset=S.old.coff or Vector3.new()
			hum.DisplayDistanceType=S.old.nd or Enum.HumanoidDisplayDistanceType.Viewer
		end
		player.CameraMaxZoomDistance=S.old.zmax or 128
		player.CameraMinZoomDistance=S.old.zmin or 0.5
		cleanup()
	end

	main.MouseButton1Click:Connect(function()
		if S.busy then return end
		if S.active then
			revert()
		else
			transform()
			if S.active then
				main.Text=T("cancel")
				showSkills(true)
				flyUI()
			end
		end
	end)
	bFly.MouseButton1Click:Connect(toggleFly)
	bSlash.MouseButton1Click:Connect(function() playAction("slash") end)
	bLaser.MouseButton1Click:Connect(function() playAction("laser") end)
	bSlam.MouseButton1Click:Connect(function() playAction("slam") end)
	bRoar.MouseButton1Click:Connect(function() playAction("roar") end)

	local function hold(btn,key)
		btn.InputBegan:Connect(function(i)
			if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
				S[key]=true
			end
		end)
		btn.InputEnded:Connect(function(i)
			if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
				S[key]=false
			end
		end)
	end
	hold(bUp,"up")
	hold(bDn,"down")

	UIS.InputBegan:Connect(function(i,gp)
		if gp then return end
		local k=i.KeyCode
		if k==Enum.KeyCode.Q then playAction("slash")
		elseif k==Enum.KeyCode.R then playAction("laser")
		elseif k==Enum.KeyCode.T then playAction("slam")
		elseif k==Enum.KeyCode.E then playAction("roar")
		elseif k==Enum.KeyCode.F then toggleFly()
		elseif k==Enum.KeyCode.Space then S.up=true
		elseif k==Enum.KeyCode.LeftControl or k==Enum.KeyCode.C then S.down=true end
	end)
	UIS.InputEnded:Connect(function(i)
		local k=i.KeyCode
		if k==Enum.KeyCode.Space then S.up=false
		elseif k==Enum.KeyCode.LeftControl or k==Enum.KeyCode.C then S.down=false end
	end)
	player.CharacterAdded:Connect(cleanup)
end

