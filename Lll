local function hideChar(char,hide)
	for _,d in ipairs(char:GetDescendants()) do
		if (d:IsA("BasePart") or d:IsA("Decal")) and d.Name~="HumanoidRootPart" then
			if hide then
				S.saved[d]=d.Transparency
				d.Transparency=1
			elseif S.saved[d] then
				d.Transparency=S.saved[d]
			end
		end
	end
