local function sc(cf)
	return CFrame.new(cf.Position*K)*(cf-cf.Position)
end

local function limb(name,size,color,mat,parent,c0,c1,class)
	local p=Instance.new(class or "Part")
	p.Name=name
	p.Size=size*K
	p.Color=color
	p.Material=mat or Enum.Material.SmoothPlastic
	p.Massless=true
	p.CanCollide=false
	p.CanQuery=false
	p.CanTouch=false
	p.Transparency=1
	p.Parent=R.model
	local w=Instance.new("Weld")
	w.Name=name.."_J"
	w.Part0=parent
	w.Part1=p
	w.C0=sc(c0)
	w.C1=sc(c1 or CFrame.new())
	w.Parent=p
	R.joints[name]=w
	R.parts[name]=p
	return p
end

